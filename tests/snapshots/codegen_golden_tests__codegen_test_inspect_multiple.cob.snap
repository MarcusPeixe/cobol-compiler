    bgeu $t0, $t1, inspect_phrase_next_101
    lw $t1, inspect_state_80
    bnez $t1, inspect_phrase_next_101
    lw $t2, inspect_operand_len_84
    addu $t2, $t0, $t2
    lw $t1, inspect_region_end_79
    bgtu $t2, $t1, inspect_phrase_mismatch_102
    move $a0, $t0
    lw $a1, inspect_operand_len_84
    lw $a2, inspect_operand_81
    lw $a3, inspect_operand_len_84
    jal rt_inspect_find
    bnez $v0, inspect_phrase_mismatch_102
    lw $a0, inspect_operand_83
    lw $a1, inspect_operand_len_84
    lw $a2, inspect_cursor_75
    lw $a3, inspect_operand_len_84
    jal rt_copy_pad
    lw $t0, inspect_cursor_75
    lw $t1, inspect_operand_len_84
    addu $t0, $t0, $t1
    sw $t0, inspect_cursor_75
    li $t0, 1
    sw $t0, inspect_state_80
    j inspect_replace_top_99
inspect_phrase_mismatch_102:
inspect_phrase_next_101:
    lw $t0, inspect_cursor_75
    lw $t1, inspect_start_87
    bltu $t0, $t1, inspect_phrase_next_103
    lw $t1, inspect_region_end_89
    bgeu $t0, $t1, inspect_phrase_next_103
    lw $t1, inspect_state_90
    bne $t0, $t1, inspect_phrase_mismatch_104
    lw $t2, inspect_operand_len_96
    addu $t2, $t0, $t2
    lw $t1, inspect_region_end_89
    bgtu $t2, $t1, inspect_phrase_mismatch_104
    move $a0, $t0
    lw $a1, inspect_operand_len_96
    lw $a2, inspect_operand_93
    lw $a3, inspect_operand_len_96
    jal rt_inspect_find
    bnez $v0, inspect_phrase_mismatch_104
    lw $a0, inspect_operand_95
    lw $a1, inspect_operand_len_96
    lw $a2, inspect_cursor_75
    lw $a3, inspect_operand_len_96
    jal rt_copy_pad
    lw $t0, inspect_cursor_75
    lw $t1, inspect_operand_len_96
    addu $t0, $t0, $t1
    sw $t0, inspect_cursor_75
    sw $t0, inspect_state_90
    j inspect_replace_top_99
inspect_phrase_mismatch_104:
    sw $zero, inspect_state_90
inspect_phrase_next_103:
    lw $t0, inspect_cursor_75
    addiu $t0, $t0, 1
    sw $t0, inspect_cursor_75
    j inspect_replace_top_99
inspect_replace_done_100:
    addiu $sp, $sp, 16
    la $a0, lit_12
    li $v0, 4
    syscall
    la $a0, ws
    li $a1, 6
    jal rt_print
    li $a0, 10
    li $v0, 11
    syscall
    la $a0, lit_0
    li $a1, 6
    addiu $sp, $sp, -8
    sw $a0, 0($sp)
    sw $a1, 4($sp)
    la $a0, ws
    li $a1, 6
    move $a2, $a0
    move $a3, $a1
    lw $a0, 0($sp)
    lw $a1, 4($sp)
    addiu $sp, $sp, 8
    jal rt_copy_pad
    la $a0, ws
    li $a1, 6
    sw $a0, inspect_cursor_107
    addu $t0, $a0, $a1
    sw $t0, inspect_end_108
    la $a0, ws
    li $a1, 6
    sw $a0, inspect_start_109
    sw $a1, inspect_region_len_110
    lw $t0, inspect_start_109
    lw $t1, inspect_region_len_110
    addu $t1, $t0, $t1
    sw $t1, inspect_region_end_111
    sw $zero, inspect_state_112
    la $a0, ws
    li $a1, 6
    sw $a1, inspect_operand_len_114
    addiu $sp, $sp, -8
    move $a2, $sp
    move $a3, $a1
    jal rt_copy_pad
    sw $sp, inspect_operand_113
    la $a0, lit_13
    li $a1, 6
    sw $a1, inspect_operand_len_116
    addiu $sp, $sp, -8
    move $a2, $sp
    move $a3, $a1
    jal rt_copy_pad
    sw $sp, inspect_operand_115
    lw $t0, inspect_operand_len_116
    lw $t1, inspect_operand_len_114
    bne $t0, $t1, inspect_invalid_117
    j inspect_valid_118
inspect_invalid_117:
    la $a0, lit_3
    li $v0, 4
    syscall
    li $v0, 10
    syscall
inspect_valid_118:
    la $a0, ws
    li $a1, 6
    sw $a0, inspect_start_119
    sw $a1, inspect_region_len_120
    lw $t0, inspect_start_119
    lw $t1, inspect_region_len_120
    addu $t1, $t0, $t1
    sw $t1, inspect_region_end_121
    sw $zero, inspect_state_122
    la $a0, lit_14
    li $a1, 1
    sw $a1, inspect_operand_len_124
    addiu $sp, $sp, -4
    move $a2, $sp
    move $a3, $a1
    jal rt_copy_pad
    sw $sp, inspect_operand_123
    lw $t0, inspect_operand_len_124
    li $t1, 1
    bne $t0, $t1, inspect_invalid_125
    j inspect_valid_126
inspect_invalid_125:
    la $a0, lit_3
    li $v0, 4
    syscall
    li $v0, 10
    syscall
inspect_valid_126:
inspect_replace_top_127:
    lw $t0, inspect_cursor_107
    lw $t1, inspect_end_108
    bgeu $t0, $t1, inspect_replace_done_128
    lw $t0, inspect_cursor_107
    lw $t1, inspect_start_109
    bltu $t0, $t1, inspect_phrase_next_129
    lw $t1, inspect_region_end_111
    bgeu $t0, $t1, inspect_phrase_next_129
    lw $t1, inspect_state_112
    bnez $t1, inspect_phrase_next_129
    lw $t2, inspect_operand_len_116
    addu $t2, $t0, $t2
    lw $t1, inspect_region_end_111
    bgtu $t2, $t1, inspect_phrase_mismatch_130
    move $a0, $t0
    lw $a1, inspect_operand_len_116
    lw $a2, inspect_operand_113
    lw $a3, inspect_operand_len_116
    jal rt_inspect_find
    bnez $v0, inspect_phrase_mismatch_130
    lw $a0, inspect_operand_115
    lw $a1, inspect_operand_len_116
    lw $a2, inspect_cursor_107
    lw $a3, inspect_operand_len_116
    jal rt_copy_pad
    lw $t0, inspect_cursor_107
    lw $t1, inspect_operand_len_116
    addu $t0, $t0, $t1
    sw $t0, inspect_cursor_107
    li $t0, 1
    sw $t0, inspect_state_112
    j inspect_replace_top_127
inspect_phrase_mismatch_130:
inspect_phrase_next_129:
    lw $t0, inspect_cursor_107
    lw $t1, inspect_start_119
    bltu $t0, $t1, inspect_phrase_next_131
    lw $t1, inspect_region_end_121
    bgeu $t0, $t1, inspect_phrase_next_131
    lw $t2, inspect_operand_len_124
    addu $t2, $t0, $t2
    lw $t1, inspect_region_end_121
    bgtu $t2, $t1, inspect_phrase_mismatch_132
    lw $a0, inspect_operand_123
    lw $a1, inspect_operand_len_124
    lw $a2, inspect_cursor_107
    lw $a3, inspect_operand_len_124
    jal rt_copy_pad
    lw $t0, inspect_cursor_107
    lw $t1, inspect_operand_len_124
    addu $t0, $t0, $t1
    sw $t0, inspect_cursor_107
    j inspect_replace_top_127
inspect_phrase_mismatch_132:
inspect_phrase_next_131:
    lw $t0, inspect_cursor_107
    addiu $t0, $t0, 1
    sw $t0, inspect_cursor_107
    j inspect_replace_top_127
inspect_replace_done_128:
    addiu $sp, $sp, 20
    la $a0, lit_15
    li $v0, 4
    syscall
    la $a0, ws
    li $a1, 6
    jal rt_print
    li $a0, 10
    li $v0, 11
    syscall
    li $v0, 10
    syscall
    li $v0, 10
    syscall

# Find the first occurrence of $a2/$a3 in $a0/$a1; return offset or -1.
rt_inspect_find:
    li $t0, 0
    subu $t1, $a1, $a3
rt_inspect_find_next:
    bgt $t0, $t1, rt_inspect_find_missing
    li $t2, 0
rt_inspect_find_compare:
    beq $t2, $a3, rt_inspect_find_found
    addu $t3, $a0, $t0
    addu $t3, $t3, $t2
    lbu $t4, 0($t3)
    addu $t3, $a2, $t2
    lbu $t5, 0($t3)
    bne $t4, $t5, rt_inspect_find_advance
    addiu $t2, $t2, 1
    j rt_inspect_find_compare
rt_inspect_find_advance:
    addiu $t0, $t0, 1
    j rt_inspect_find_next
rt_inspect_find_found:
    move $v0, $t0
    jr $ra
rt_inspect_find_missing:
    li $v0, -1
    jr $ra

# Convert $v1 bytes at $a0 using $a2 bytes of mapping $a1 -> $a3.
rt_inspect_convert:
    li $t0, 0
rt_inspect_convert_next:
    beq $t0, $v1, rt_inspect_convert_done
    addu $t1, $a0, $t0
    lbu $t2, 0($t1)
    li $t3, 0
rt_inspect_convert_lookup:
    beq $t3, $a2, rt_inspect_convert_advance
    addu $t4, $a1, $t3
    lbu $t5, 0($t4)
    beq $t2, $t5, rt_inspect_convert_replace
    addiu $t3, $t3, 1
    j rt_inspect_convert_lookup
rt_inspect_convert_replace:
    addu $t4, $a3, $t3
    lbu $t5, 0($t4)
    sb $t5, 0($t1)
rt_inspect_convert_advance:
    addiu $t0, $t0, 1
    j rt_inspect_convert_next
rt_inspect_convert_done:
    jr $ra

# ---- runtime -------------------------------------------------------------
# rt_print: $a0 = address, $a1 = length. Prints the bytes.
rt_print:
    move $t0, $a0
    addu $t1, $a0, $a1
rt_print_l:
    beq $t0, $t1, rt_print_d
    lbu $a0, 0($t0)
    li $v0, 11
    syscall
    addiu $t0, $t0, 1
    j rt_print_l
rt_print_d:
    jr $ra

# rt_print_num: $a0 = address, $a1 = size, $a2 = scale, $a3 = signed.
# Prints a DISPLAY numeric field: optional sign, digits, decimal point.
rt_print_num:
    move $t0, $a0
    addu $t1, $a0, $a1
    beqz $a3, rt_print_num_digits
    lbu $t2, -1($t1)
    li $a0, 43
    sltiu $t3, $t2, 0x70
    bnez $t3, rt_print_num_sign
    li $a0, 45
rt_print_num_sign:
    li $v0, 11
    syscall
rt_print_num_digits:
    subu $t4, $a1, $a2
    li $t5, 0
rt_print_num_l:
    beq $t5, $a1, rt_print_num_d
    beqz $a2, rt_print_num_nopt
    bne $t5, $t4, rt_print_num_nopt
    li $a0, 46
    li $v0, 11
    syscall
rt_print_num_nopt:
    addu $t6, $t0, $t5
    lbu $a0, 0($t6)
    sltiu $t7, $a0, 0x70
    bnez $t7, rt_print_num_ch
    addiu $a0, $a0, -0x40
rt_print_num_ch:
    li $v0, 11
    syscall
    addiu $t5, $t5, 1
    j rt_print_num_l
rt_print_num_d:
    jr $ra

# rt_print_val: $a0 = scaled integer value, $a1 = scale. Prints it with a decimal point.
rt_print_val:
    move $t0, $a0
    bgez $t0, rt_print_val_abs
    li $a0, 45
    li $v0, 11
    syscall
    negu $t0, $t0
rt_print_val_abs:
    li $t1, 1
    li $t2, 0
    li $t3, 10
rt_print_val_p:
    beq $t2, $a1, rt_print_val_i
    mul $t1, $t1, $t3
    addiu $t2, $t2, 1
    j rt_print_val_p
rt_print_val_i:
    div $t0, $t1
    mflo $a0
    mfhi $t0
    li $v0, 1
    syscall
    beqz $a1, rt_print_val_d
    li $a0, 46
    li $v0, 11
    syscall
rt_print_val_f:
    beqz $a1, rt_print_val_d
    div $t1, $t3
    mflo $t1
    div $t0, $t1
    mflo $a0
    mfhi $t0
    addiu $a0, $a0, 48
    li $v0, 11
    syscall
    addiu $a1, $a1, -1
    j rt_print_val_f
rt_print_val_d:
    jr $ra

# rt_num_load: $a0 = address, $a1 = size. Returns the signed integer in $v0.
rt_num_load:
    li $v0, 0
    li $t2, 0
    li $t4, 10
    addu $t1, $a0, $a1
rt_num_load_l:
    beq $a0, $t1, rt_num_load_d
    lbu $t0, 0($a0)
    sltiu $t3, $t0, 0x70
    bnez $t3, rt_num_load_c
    addiu $t0, $t0, -0x40
    li $t2, 1
rt_num_load_c:
    addiu $t0, $t0, -48
    sltiu $t3, $t0, 10
    bnez $t3, rt_num_load_ok
    li $t0, 0
rt_num_load_ok:
    mul $v0, $v0, $t4
    addu $v0, $v0, $t0
    addiu $a0, $a0, 1
    j rt_num_load_l
rt_num_load_d:
    beqz $t2, rt_num_load_r
    negu $v0, $v0
rt_num_load_r:
    jr $ra

# rt_num_store: $a0 = address, $a1 = size, $a2 = signed, $a3 = value.
# Stores the low-order digits of |value|; a negative value in a signed field
# gets an overpunched last digit ('p'-'y').
rt_num_store:
    slt $t2, $a3, $zero
    bgez $a3, rt_num_store_abs
    negu $a3, $a3
rt_num_store_abs:
    addu $t0, $a0, $a1
    li $t4, 10
rt_num_store_l:
    beq $t0, $a0, rt_num_store_sign
    addiu $t0, $t0, -1
    div $a3, $t4
    mflo $a3
    mfhi $t3
    addiu $t3, $t3, 48
    sb $t3, 0($t0)
    j rt_num_store_l
rt_num_store_sign:
    beqz $a2, rt_num_store_d
    beqz $t2, rt_num_store_d
    addu $t0, $a0, $a1
    lbu $t3, -1($t0)
    addiu $t3, $t3, 0x40
    sb $t3, -1($t0)
rt_num_store_d:
    jr $ra

# rt_fits: $a1 = size, $a3 = value. $v0 = 1 when |value| < 10^size.
rt_fits:
    li $v0, 1
    slti $t0, $a1, 10
    beqz $t0, rt_fits_d
    move $t0, $a3
    bgez $t0, rt_fits_p
    negu $t0, $t0
rt_fits_p:
    li $t1, 1
    li $t2, 0
    li $t4, 10
rt_fits_l:
    beq $t2, $a1, rt_fits_c
    mul $t1, $t1, $t4
    addiu $t2, $t2, 1
    j rt_fits_l
rt_fits_c:
    slt $v0, $t0, $t1
rt_fits_d:
    jr $ra

# rt_copy_pad: $a0 = source, $a1 = source length, $a2 = destination, $a3 = destination length.
# Copies, truncating on the right or padding with spaces.
rt_copy_pad:
    li $t4, 32
rt_copy_pad_l:
    beqz $a3, rt_copy_pad_d
    beqz $a1, rt_copy_pad_p
    lbu $t0, 0($a0)
    sb $t0, 0($a2)
    addiu $a0, $a0, 1
    addiu $a1, $a1, -1
    addiu $a2, $a2, 1
    addiu $a3, $a3, -1
    j rt_copy_pad_l
rt_copy_pad_p:
    beqz $a3, rt_copy_pad_d
    sb $t4, 0($a2)
    addiu $a2, $a2, 1
    addiu $a3, $a3, -1
    j rt_copy_pad_p
rt_copy_pad_d:
    jr $ra

# rt_fill: $a0 = destination, $a1 = length, $a2 = byte.
rt_fill:
    beqz $a1, rt_fill_d
    sb $a2, 0($a0)
    addiu $a0, $a0, 1
    addiu $a1, $a1, -1
    j rt_fill
rt_fill_d:
    jr $ra

# rt_cmp: ($a0, $a1) and ($a2, $a3) are (address, length) pairs.
# Returns -1, 0 or 1 in $v0, padding the shorter operand with spaces.
rt_cmp:
    li $t4, 32
rt_cmp_l:
    or $t0, $a1, $a3
    beqz $t0, rt_cmp_eq
    move $t1, $t4
    beqz $a1, rt_cmp_a
    lbu $t1, 0($a0)
    addiu $a0, $a0, 1
    addiu $a1, $a1, -1
rt_cmp_a:
    move $t2, $t4
    beqz $a3, rt_cmp_b
    lbu $t2, 0($a2)
    addiu $a2, $a2, 1
    addiu $a3, $a3, -1
rt_cmp_b:
    beq $t1, $t2, rt_cmp_l
    sltu $t3, $t1, $t2
    li $v0, -1
    bnez $t3, rt_cmp_r
    li $v0, 1
rt_cmp_r:
    jr $ra
rt_cmp_eq:
    li $v0, 0
    jr $ra

# rt_accept_str: $a0 = destination, $a1 = destination length. Reads a line.
rt_accept_str:
    addiu $sp, $sp, -12
    sw $ra, 0($sp)
    sw $a0, 4($sp)
    sw $a1, 8($sp)
    la $a0, tmp_buf
    li $a1, 255
    li $v0, 8
    syscall
    la $t0, tmp_buf
rt_accept_str_l:
    lbu $t1, 0($t0)
    beqz $t1, rt_accept_str_e
    li $t2, 10
    beq $t1, $t2, rt_accept_str_e
    addiu $t0, $t0, 1
    j rt_accept_str_l
rt_accept_str_e:
    la $a0, tmp_buf
    subu $a1, $t0, $a0
    lw $a2, 4($sp)
    lw $a3, 8($sp)
    jal rt_copy_pad
    lw $ra, 0($sp)
    addiu $sp, $sp, 12
    jr $ra

# rt_accept_num: $a0 = target scale. Reads a line holding a number such as
# -12.5 and returns it scaled to the target scale in $v0 (extra decimals are truncated).
rt_accept_num:
    move $t9, $a0
    la $a0, tmp_buf
    li $a1, 255
    li $v0, 8
    syscall
    la $t0, tmp_buf
    li $v0, 0
    li $t2, 0
    li $t3, 0
    li $t4, 0
    li $t5, 10
rt_accept_num_l:
    lbu $t1, 0($t0)
    beqz $t1, rt_accept_num_adj
    li $t6, 45
    bne $t1, $t6, rt_accept_num_nm
    li $t2, 1
    j rt_accept_num_n
rt_accept_num_nm:
    li $t6, 46
    bne $t1, $t6, rt_accept_num_dg
    li $t4, 1
    j rt_accept_num_n
rt_accept_num_dg:
    addiu $t1, $t1, -48
    sltiu $t6, $t1, 10
    beqz $t6, rt_accept_num_n
    beqz $t4, rt_accept_num_acc
    bge $t3, $t9, rt_accept_num_n
    addiu $t3, $t3, 1
rt_accept_num_acc:
    mul $v0, $v0, $t5
    addu $v0, $v0, $t1
rt_accept_num_n:
    addiu $t0, $t0, 1
    j rt_accept_num_l
rt_accept_num_adj:
    bge $t3, $t9, rt_accept_num_sg
    mul $v0, $v0, $t5
    addiu $t3, $t3, 1
    j rt_accept_num_adj
rt_accept_num_sg:
    beqz $t2, rt_accept_num_r
    negu $v0, $v0
rt_accept_num_r:
    jr $ra

# rt_pow: $a0 = scaled base, $a1 = integer exponent, $a2 = 10^scale.
# Returns base^exponent with the base's scale.
rt_pow:
    move $v0, $a2
rt_pow_l:
    blez $a1, rt_pow_d
    mul $v0, $v0, $a0
    div $v0, $a2
    mflo $v0
    addiu $a1, $a1, -1
    j rt_pow_l
rt_pow_d:
    jr $ra

# rt_case: $a0 = address, $a1 = length, $a2 = 1 for upper case, 0 for lower case. In place.
rt_case:
    addu $t0, $a0, $a1
rt_case_l:
    beq $a0, $t0, rt_case_d
    lbu $t1, 0($a0)
    beqz $a2, rt_case_lo
    li $t2, 97
    li $t3, 122
    blt $t1, $t2, rt_case_n
    bgt $t1, $t3, rt_case_n
    addiu $t1, $t1, -32
    sb $t1, 0($a0)
    j rt_case_n
rt_case_lo:
    li $t2, 65
    li $t3, 90
    blt $t1, $t2, rt_case_n
    bgt $t1, $t3, rt_case_n
    addiu $t1, $t1, 32
    sb $t1, 0($a0)
rt_case_n:
    addiu $a0, $a0, 1
    j rt_case_l
rt_case_d:
    jr $ra

# rt_edit: $a0 = destination, $a1 = picture (NUL-terminated), $a2 = scaled value.
# Numeric editing with 9 Z * . , B 0 / $ and a single leading or trailing + or -.
rt_edit:
    slt $t9, $a2, $zero
    bgez $a2, rt_edit_abs
    negu $a2, $a2
rt_edit_abs:
    move $t0, $a1
    li $t1, 0
rt_edit_count:
    lbu $t2, 0($t0)
    beqz $t2, rt_edit_digits
    li $t3, 57
    beq $t2, $t3, rt_edit_cn
    li $t3, 90
    beq $t2, $t3, rt_edit_cn
    li $t3, 42
    beq $t2, $t3, rt_edit_cn
    j rt_edit_cs
rt_edit_cn:
    addiu $t1, $t1, 1
rt_edit_cs:
    addiu $t0, $t0, 1
    j rt_edit_count
rt_edit_digits:
    la $t4, ed_digits
    addu $t5, $t4, $t1
    li $t6, 10
rt_edit_dl:
    beq $t5, $t4, rt_edit_walk
    addiu $t5, $t5, -1
    div $a2, $t6
    mflo $a2
    mfhi $t7
    sb $t7, 0($t5)
    j rt_edit_dl
rt_edit_walk:
    move $t0, $a1
    move $t1, $a0
    li $t8, 1
rt_edit_w:
    lbu $t2, 0($t0)
    beqz $t2, rt_edit_end
    li $t3, 57
    beq $t2, $t3, rt_edit_9
    li $t3, 90
    beq $t2, $t3, rt_edit_z
    li $t3, 42
    beq $t2, $t3, rt_edit_star
    li $t3, 46
    beq $t2, $t3, rt_edit_pt
    li $t3, 44
    beq $t2, $t3, rt_edit_cm
    li $t3, 66
    beq $t2, $t3, rt_edit_b
    li $t3, 45
    beq $t2, $t3, rt_edit_minus
    li $t3, 43
    beq $t2, $t3, rt_edit_plus
    move $t7, $t2
    j rt_edit_out
rt_edit_9:
    lbu $t7, 0($t4)
    addiu $t4, $t4, 1
    addiu $t7, $t7, 48
    li $t8, 0
    j rt_edit_out
rt_edit_z:
    lbu $t7, 0($t4)
    addiu $t4, $t4, 1
    bnez $t7, rt_edit_znz
    beqz $t8, rt_edit_znz
    li $t7, 32
    j rt_edit_out
rt_edit_znz:
    addiu $t7, $t7, 48
    li $t8, 0
    j rt_edit_out
rt_edit_star:
    lbu $t7, 0($t4)
    addiu $t4, $t4, 1
    bnez $t7, rt_edit_snz
    beqz $t8, rt_edit_snz
    li $t7, 42
    j rt_edit_out
rt_edit_snz:
    addiu $t7, $t7, 48
    li $t8, 0
    j rt_edit_out
rt_edit_pt:
    li $t7, 46
    li $t8, 0
    j rt_edit_out
rt_edit_cm:
    li $t7, 44
    beqz $t8, rt_edit_out
    li $t7, 32
    j rt_edit_out
rt_edit_b:
    li $t7, 32
    j rt_edit_out
rt_edit_minus:
    li $t7, 32
    beqz $t9, rt_edit_out
    li $t7, 45
    j rt_edit_out
rt_edit_plus:
    li $t7, 43
    beqz $t9, rt_edit_out
    li $t7, 45
rt_edit_out:
    sb $t7, 0($t1)
    addiu $t1, $t1, 1
    addiu $t0, $t0, 1
    j rt_edit_w
rt_edit_end:
    jr $ra
