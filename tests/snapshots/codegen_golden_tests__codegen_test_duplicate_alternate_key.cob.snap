# Compare $a2 bytes at $a0 and $a1; $a3 selects signed DISPLAY ordering.
rt_index_compare:
    bnez $a3, rt_index_compare_numeric
    move $t0, $zero
rt_index_compare_loop:
    beq $t0, $a2, rt_index_compare_equal
    addu $t1, $a0, $t0
    lbu $t2, 0($t1)
    addu $t1, $a1, $t0
    lbu $t3, 0($t1)
    blt $t2, $t3, rt_index_compare_less
    bgt $t2, $t3, rt_index_compare_greater
    addiu $t0, $t0, 1
    j rt_index_compare_loop
rt_index_compare_less:
    li $v0, -1
    jr $ra
rt_index_compare_greater:
    li $v0, 1
    jr $ra
rt_index_compare_equal:
    move $v0, $zero
    jr $ra

rt_index_compare_numeric:
    addu $t0, $a0, $a2
    lbu $t4, -1($t0)
    sltiu $t4, $t4, 0x70
    xori $t4, $t4, 1
    addu $t0, $a1, $a2
    lbu $t5, -1($t0)
    sltiu $t5, $t5, 0x70
    xori $t5, $t5, 1
    move $t0, $zero
    move $t6, $zero
    move $t7, $zero
    move $t8, $zero
rt_index_compare_numeric_loop:
    beq $t0, $a2, rt_index_compare_numeric_sign
    addu $t1, $a0, $t0
    lbu $t2, 0($t1)
    addu $t1, $a1, $t0
    lbu $t3, 0($t1)
    addiu $t1, $a2, -1
    bne $t0, $t1, rt_index_compare_numeric_digits
    beqz $t4, rt_index_compare_numeric_right
    addiu $t2, $t2, -0x40
rt_index_compare_numeric_right:
    beqz $t5, rt_index_compare_numeric_digits
    addiu $t3, $t3, -0x40
rt_index_compare_numeric_digits:
    addiu $t2, $t2, -48
    addiu $t3, $t3, -48
    or $t7, $t7, $t2
    or $t8, $t8, $t3
    bnez $t6, rt_index_compare_numeric_next
    slt $t1, $t2, $t3
    slt $t9, $t3, $t2
    subu $t6, $t9, $t1
rt_index_compare_numeric_next:
    addiu $t0, $t0, 1
    j rt_index_compare_numeric_loop
rt_index_compare_numeric_sign:
    sltu $t7, $zero, $t7
    sltu $t8, $zero, $t8
    and $t4, $t4, $t7
    and $t5, $t5, $t8
    beq $t4, $t5, rt_index_compare_numeric_same_sign
    subu $v0, $t5, $t4
    jr $ra
rt_index_compare_numeric_same_sign:
    move $v0, $t6
    beqz $t4, rt_index_compare_numeric_done
    negu $v0, $v0
rt_index_compare_numeric_done:
    jr $ra

# Select =, >, >=, <, <=, first, or next (0..6), preserving duplicate order.
# $a0=head, $a1=key (or cursor for next), $a2=offset, $a3=length;
# relation and signed-key flag are on the stack.
rt_index_select:
    lw $t0, 0($sp)
    lw $t1, 4($sp)
    addiu $sp, $sp, -36
    sw $s0, 0($sp)
    sw $s1, 4($sp)
    sw $s2, 8($sp)
    sw $s3, 12($sp)
    sw $s4, 16($sp)
    sw $s5, 20($sp)
    sw $s6, 24($sp)
    sw $s7, 28($sp)
    sw $ra, 32($sp)
    move $s0, $a0
    move $s1, $a1
    move $s2, $a2
    move $s3, $a3
    move $s4, $t0
    move $s7, $t1
    move $s5, $zero
    move $s6, $s0
rt_index_select_loop:
    beqz $s6, rt_index_select_done
    li $t0, 5
    beq $s4, $t0, rt_index_select_candidate
    addiu $a0, $s6, 4
    addu $a0, $a0, $s2
    move $a1, $s1
    li $t0, 6
    bne $s4, $t0, rt_index_select_compare
    addiu $a1, $s1, 4
    addu $a1, $a1, $s2
rt_index_select_compare:
    move $a2, $s3
    move $a3, $s7
    jal rt_index_compare
    li $t0, 6
    beq $s4, $t0, rt_index_select_after_cursor
    beqz $s4, rt_index_select_equal
    li $t0, 1
    beq $s4, $t0, rt_index_select_gt
    li $t0, 2
    beq $s4, $t0, rt_index_select_ge
    li $t0, 3
    beq $s4, $t0, rt_index_select_lt
    blez $v0, rt_index_select_candidate
    j rt_index_select_next
rt_index_select_equal:
    beqz $v0, rt_index_select_candidate
    j rt_index_select_next
rt_index_select_gt:
    bgtz $v0, rt_index_select_candidate
    j rt_index_select_next
rt_index_select_ge:
    bgez $v0, rt_index_select_candidate
    j rt_index_select_next
rt_index_select_lt:
    bltz $v0, rt_index_select_candidate
    j rt_index_select_next
rt_index_select_after_cursor:
    bgtz $v0, rt_index_select_candidate
    bnez $v0, rt_index_select_next
    bgtu $s6, $s1, rt_index_select_candidate
    j rt_index_select_next
rt_index_select_candidate:
    beqz $s5, rt_index_select_take
    addiu $a0, $s6, 4
    addu $a0, $a0, $s2
    addiu $a1, $s5, 4
    addu $a1, $a1, $s2
    move $a2, $s3
    move $a3, $s7
    jal rt_index_compare
    bnez $v0, rt_index_select_compare_direction
    bltu $s6, $s5, rt_index_select_take
    j rt_index_select_next
rt_index_select_compare_direction:
    li $t0, 3
    beq $s4, $t0, rt_index_select_max
    li $t0, 4
    beq $s4, $t0, rt_index_select_max
    bltz $v0, rt_index_select_take
    j rt_index_select_next
rt_index_select_max:
    bgtz $v0, rt_index_select_take
    j rt_index_select_next
rt_index_select_take:
    move $s5, $s6
rt_index_select_next:
    lw $s6, 0($s6)
    j rt_index_select_loop
rt_index_select_done:
    move $v0, $s5
    lw $s0, 0($sp)
    lw $s1, 4($sp)
    lw $s2, 8($sp)
    lw $s3, 12($sp)
    lw $s4, 16($sp)
    lw $s5, 20($sp)
    lw $s6, 24($sp)
    lw $s7, 28($sp)
    lw $ra, 32($sp)
    addiu $sp, $sp, 36
    jr $ra

# $a0=&head, $a1=record, $a2=record size.
rt_index_append:
    move $t0, $a0
    move $t1, $a1
    move $t2, $a2
    addiu $a0, $a2, 7
    li $t3, -4
    and $a0, $a0, $t3
    li $v0, 9
    syscall
    lw $t3, 0($t0)
    sw $t3, 0($v0)
    sw $v0, 0($t0)
    addiu $t3, $v0, 4
    li $t4, 0
rt_index_append_copy:
    beq $t4, $t2, rt_index_append_done
    addu $t5, $t1, $t4
    lbu $t6, 0($t5)
    addu $t5, $t3, $t4
    sb $t6, 0($t5)
    addiu $t4, $t4, 1
    j rt_index_append_copy
rt_index_append_done:
    jr $ra

# $a0=descriptor, $a1=&head, $a2=record size. Returns 0 or -1.
rt_index_load:
    addiu $sp, $sp, -20
    sw $s0, 0($sp)
    sw $s1, 4($sp)
    sw $s2, 8($sp)
    sw $s3, 12($sp)
    sw $ra, 16($sp)
    move $s0, $a0
    move $s1, $a1
    move $s2, $a2
rt_index_load_next:
    addiu $a0, $s2, 7
    li $t0, -4
    and $a0, $a0, $t0
    li $v0, 9
    syscall
    move $s3, $v0
    move $a0, $s0
    addiu $a1, $s3, 4
    move $a2, $s2
    li $v0, 14
    syscall
    beqz $v0, rt_index_load_done
    bne $v0, $s2, rt_index_load_failed
    lw $t0, 0($s1)
    sw $t0, 0($s3)
    sw $s3, 0($s1)
    j rt_index_load_next
rt_index_load_failed:
    li $v0, -1
    j rt_index_load_return
rt_index_load_done:
    move $v0, $zero
rt_index_load_return:
    lw $s0, 0($sp)
    lw $s1, 4($sp)
    lw $s2, 8($sp)
    lw $s3, 12($sp)
    lw $ra, 16($sp)
    addiu $sp, $sp, 20
    jr $ra

# ---- runtime -------------------------------------------------------------
# rt_print: $a0 = address, $a1 = length. Prints the bytes.
rt_print:
    move $t0, $a0
    addu $t1, $a0, $a1
rt_print_l:
    beq $t0, $t1, rt_print_d
    lbu $a0, 0($t0)
    li $v0, 11
    syscall
    addiu $t0, $t0, 1
    j rt_print_l
rt_print_d:
    jr $ra

# rt_print_num: $a0 = address, $a1 = size, $a2 = scale, $a3 = signed.
# Prints a DISPLAY numeric field: optional sign, digits, decimal point.
rt_print_num:
    move $t0, $a0
    addu $t1, $a0, $a1
    beqz $a3, rt_print_num_digits
    lbu $t2, -1($t1)
    li $a0, 43
    sltiu $t3, $t2, 0x70
    bnez $t3, rt_print_num_sign
    li $a0, 45
rt_print_num_sign:
    li $v0, 11
    syscall
rt_print_num_digits:
    subu $t4, $a1, $a2
    li $t5, 0
rt_print_num_l:
    beq $t5, $a1, rt_print_num_d
    beqz $a2, rt_print_num_nopt
    bne $t5, $t4, rt_print_num_nopt
    li $a0, 46
    li $v0, 11
    syscall
rt_print_num_nopt:
    addu $t6, $t0, $t5
    lbu $a0, 0($t6)
    sltiu $t7, $a0, 0x70
    bnez $t7, rt_print_num_ch
    addiu $a0, $a0, -0x40
rt_print_num_ch:
    li $v0, 11
    syscall
    addiu $t5, $t5, 1
    j rt_print_num_l
rt_print_num_d:
    jr $ra

# rt_print_val: $a0 = scaled integer value, $a1 = scale. Prints it with a decimal point.
rt_print_val:
    move $t0, $a0
    bgez $t0, rt_print_val_abs
    li $a0, 45
    li $v0, 11
    syscall
    negu $t0, $t0
rt_print_val_abs:
    li $t1, 1
    li $t2, 0
    li $t3, 10
rt_print_val_p:
    beq $t2, $a1, rt_print_val_i
    mul $t1, $t1, $t3
    addiu $t2, $t2, 1
    j rt_print_val_p
rt_print_val_i:
    div $t0, $t1
    mflo $a0
    mfhi $t0
    li $v0, 1
    syscall
    beqz $a1, rt_print_val_d
    li $a0, 46
    li $v0, 11
    syscall
rt_print_val_f:
    beqz $a1, rt_print_val_d
    div $t1, $t3
    mflo $t1
    div $t0, $t1
    mflo $a0
    mfhi $t0
    addiu $a0, $a0, 48
    li $v0, 11
    syscall
    addiu $a1, $a1, -1
    j rt_print_val_f
rt_print_val_d:
    jr $ra

# rt_num_load: $a0 = address, $a1 = size. Returns the signed integer in $v0.
rt_num_load:
    li $v0, 0
    li $t2, 0
    li $t4, 10
    addu $t1, $a0, $a1
rt_num_load_l:
    beq $a0, $t1, rt_num_load_d
    lbu $t0, 0($a0)
    sltiu $t3, $t0, 0x70
    bnez $t3, rt_num_load_c
    addiu $t0, $t0, -0x40
    li $t2, 1
rt_num_load_c:
    addiu $t0, $t0, -48
    sltiu $t3, $t0, 10
    bnez $t3, rt_num_load_ok
    li $t0, 0
rt_num_load_ok:
    mul $v0, $v0, $t4
    addu $v0, $v0, $t0
    addiu $a0, $a0, 1
    j rt_num_load_l
rt_num_load_d:
    beqz $t2, rt_num_load_r
    negu $v0, $v0
rt_num_load_r:
    jr $ra

# rt_num_store: $a0 = address, $a1 = size, $a2 = signed, $a3 = value.
# Stores the low-order digits of |value|; a negative value in a signed field
# gets an overpunched last digit ('p'-'y').
rt_num_store:
    slt $t2, $a3, $zero
    bgez $a3, rt_num_store_abs
    negu $a3, $a3
rt_num_store_abs:
    addu $t0, $a0, $a1
    li $t4, 10
rt_num_store_l:
    beq $t0, $a0, rt_num_store_sign
    addiu $t0, $t0, -1
    div $a3, $t4
    mflo $a3
    mfhi $t3
    addiu $t3, $t3, 48
    sb $t3, 0($t0)
    j rt_num_store_l
rt_num_store_sign:
    beqz $a2, rt_num_store_d
    beqz $t2, rt_num_store_d
    addu $t0, $a0, $a1
    lbu $t3, -1($t0)
    addiu $t3, $t3, 0x40
    sb $t3, -1($t0)
rt_num_store_d:
    jr $ra

# rt_fits: $a1 = size, $a3 = value. $v0 = 1 when |value| < 10^size.
rt_fits:
    li $v0, 1
    slti $t0, $a1, 10
    beqz $t0, rt_fits_d
    move $t0, $a3
    bgez $t0, rt_fits_p
    negu $t0, $t0
rt_fits_p:
    li $t1, 1
    li $t2, 0
    li $t4, 10
rt_fits_l:
    beq $t2, $a1, rt_fits_c
    mul $t1, $t1, $t4
    addiu $t2, $t2, 1
    j rt_fits_l
rt_fits_c:
    slt $v0, $t0, $t1
rt_fits_d:
    jr $ra

# rt_copy_pad: $a0 = source, $a1 = source length, $a2 = destination, $a3 = destination length.
# Copies, truncating on the right or padding with spaces.
rt_copy_pad:
    li $t4, 32
rt_copy_pad_l:
    beqz $a3, rt_copy_pad_d
    beqz $a1, rt_copy_pad_p
    lbu $t0, 0($a0)
    sb $t0, 0($a2)
    addiu $a0, $a0, 1
    addiu $a1, $a1, -1
    addiu $a2, $a2, 1
    addiu $a3, $a3, -1
    j rt_copy_pad_l
rt_copy_pad_p:
    beqz $a3, rt_copy_pad_d
    sb $t4, 0($a2)
    addiu $a2, $a2, 1
    addiu $a3, $a3, -1
    j rt_copy_pad_p
rt_copy_pad_d:
    jr $ra

# rt_fill: $a0 = destination, $a1 = length, $a2 = byte.
rt_fill:
    beqz $a1, rt_fill_d
    sb $a2, 0($a0)
    addiu $a0, $a0, 1
    addiu $a1, $a1, -1
    j rt_fill
rt_fill_d:
    jr $ra

# rt_cmp: ($a0, $a1) and ($a2, $a3) are (address, length) pairs.
# Returns -1, 0 or 1 in $v0, padding the shorter operand with spaces.
rt_cmp:
    li $t4, 32
rt_cmp_l:
    or $t0, $a1, $a3
    beqz $t0, rt_cmp_eq
    move $t1, $t4
    beqz $a1, rt_cmp_a
    lbu $t1, 0($a0)
    addiu $a0, $a0, 1
    addiu $a1, $a1, -1
rt_cmp_a:
    move $t2, $t4
    beqz $a3, rt_cmp_b
    lbu $t2, 0($a2)
    addiu $a2, $a2, 1
    addiu $a3, $a3, -1
rt_cmp_b:
    beq $t1, $t2, rt_cmp_l
    sltu $t3, $t1, $t2
    li $v0, -1
    bnez $t3, rt_cmp_r
    li $v0, 1
rt_cmp_r:
    jr $ra
rt_cmp_eq:
    li $v0, 0
    jr $ra

# rt_accept_str: $a0 = destination, $a1 = destination length. Reads a line.
rt_accept_str:
    addiu $sp, $sp, -12
    sw $ra, 0($sp)
    sw $a0, 4($sp)
    sw $a1, 8($sp)
    la $a0, tmp_buf
    li $a1, 255
    li $v0, 8
    syscall
    la $t0, tmp_buf
rt_accept_str_l:
    lbu $t1, 0($t0)
    beqz $t1, rt_accept_str_e
    li $t2, 10
    beq $t1, $t2, rt_accept_str_e
    addiu $t0, $t0, 1
    j rt_accept_str_l
rt_accept_str_e:
    la $a0, tmp_buf
    subu $a1, $t0, $a0
    lw $a2, 4($sp)
    lw $a3, 8($sp)
    jal rt_copy_pad
    lw $ra, 0($sp)
    addiu $sp, $sp, 12
    jr $ra

# rt_accept_num: $a0 = target scale. Reads a line holding a number such as
# -12.5 and returns it scaled to the target scale in $v0 (extra decimals are truncated).
rt_accept_num:
    move $t9, $a0
    la $a0, tmp_buf
    li $a1, 255
    li $v0, 8
    syscall
    la $t0, tmp_buf
    li $v0, 0
    li $t2, 0
    li $t3, 0
    li $t4, 0
    li $t5, 10
rt_accept_num_l:
    lbu $t1, 0($t0)
    beqz $t1, rt_accept_num_adj
    li $t6, 45
    bne $t1, $t6, rt_accept_num_nm
    li $t2, 1
    j rt_accept_num_n
rt_accept_num_nm:
    li $t6, 46
    bne $t1, $t6, rt_accept_num_dg
    li $t4, 1
    j rt_accept_num_n
rt_accept_num_dg:
    addiu $t1, $t1, -48
    sltiu $t6, $t1, 10
    beqz $t6, rt_accept_num_n
    beqz $t4, rt_accept_num_acc
    bge $t3, $t9, rt_accept_num_n
    addiu $t3, $t3, 1
rt_accept_num_acc:
    mul $v0, $v0, $t5
    addu $v0, $v0, $t1
rt_accept_num_n:
    addiu $t0, $t0, 1
    j rt_accept_num_l
rt_accept_num_adj:
    bge $t3, $t9, rt_accept_num_sg
    mul $v0, $v0, $t5
    addiu $t3, $t3, 1
    j rt_accept_num_adj
rt_accept_num_sg:
    beqz $t2, rt_accept_num_r
    negu $v0, $v0
rt_accept_num_r:
    jr $ra

# rt_pow: $a0 = scaled base, $a1 = integer exponent, $a2 = 10^scale.
# Returns base^exponent with the base's scale.
rt_pow:
    move $v0, $a2
rt_pow_l:
    blez $a1, rt_pow_d
    mul $v0, $v0, $a0
    div $v0, $a2
    mflo $v0
    addiu $a1, $a1, -1
    j rt_pow_l
rt_pow_d:
    jr $ra

# rt_case: $a0 = address, $a1 = length, $a2 = 1 for upper case, 0 for lower case. In place.
rt_case:
    addu $t0, $a0, $a1
rt_case_l:
    beq $a0, $t0, rt_case_d
    lbu $t1, 0($a0)
    beqz $a2, rt_case_lo
    li $t2, 97
    li $t3, 122
    blt $t1, $t2, rt_case_n
    bgt $t1, $t3, rt_case_n
    addiu $t1, $t1, -32
    sb $t1, 0($a0)
    j rt_case_n
rt_case_lo:
    li $t2, 65
    li $t3, 90
    blt $t1, $t2, rt_case_n
    bgt $t1, $t3, rt_case_n
    addiu $t1, $t1, 32
    sb $t1, 0($a0)
rt_case_n:
    addiu $a0, $a0, 1
    j rt_case_l
rt_case_d:
    jr $ra

# rt_edit: $a0 = destination, $a1 = picture (NUL-terminated), $a2 = scaled value.
# Numeric editing with 9 Z * . , B 0 / $ and a single leading or trailing + or -.
rt_edit:
    slt $t9, $a2, $zero
    bgez $a2, rt_edit_abs
    negu $a2, $a2
rt_edit_abs:
    move $t0, $a1
    li $t1, 0
rt_edit_count:
    lbu $t2, 0($t0)
    beqz $t2, rt_edit_digits
    li $t3, 57
    beq $t2, $t3, rt_edit_cn
    li $t3, 90
    beq $t2, $t3, rt_edit_cn
    li $t3, 42
    beq $t2, $t3, rt_edit_cn
    j rt_edit_cs
rt_edit_cn:
    addiu $t1, $t1, 1
rt_edit_cs:
    addiu $t0, $t0, 1
    j rt_edit_count
rt_edit_digits:
    la $t4, ed_digits
    addu $t5, $t4, $t1
    li $t6, 10
rt_edit_dl:
    beq $t5, $t4, rt_edit_walk
    addiu $t5, $t5, -1
    div $a2, $t6
    mflo $a2
    mfhi $t7
    sb $t7, 0($t5)
    j rt_edit_dl
rt_edit_walk:
    move $t0, $a1
    move $t1, $a0
    li $t8, 1
rt_edit_w:
    lbu $t2, 0($t0)
    beqz $t2, rt_edit_end
    li $t3, 57
    beq $t2, $t3, rt_edit_9
    li $t3, 90
    beq $t2, $t3, rt_edit_z
    li $t3, 42
    beq $t2, $t3, rt_edit_star
    li $t3, 46
    beq $t2, $t3, rt_edit_pt
    li $t3, 44
    beq $t2, $t3, rt_edit_cm
    li $t3, 66
    beq $t2, $t3, rt_edit_b
    li $t3, 45
    beq $t2, $t3, rt_edit_minus
    li $t3, 43
    beq $t2, $t3, rt_edit_plus
    move $t7, $t2
    j rt_edit_out
rt_edit_9:
    lbu $t7, 0($t4)
    addiu $t4, $t4, 1
    addiu $t7, $t7, 48
    li $t8, 0
    j rt_edit_out
rt_edit_z:
    lbu $t7, 0($t4)
    addiu $t4, $t4, 1
    bnez $t7, rt_edit_znz
    beqz $t8, rt_edit_znz
    li $t7, 32
    j rt_edit_out
rt_edit_znz:
    addiu $t7, $t7, 48
    li $t8, 0
    j rt_edit_out
rt_edit_star:
    lbu $t7, 0($t4)
    addiu $t4, $t4, 1
    bnez $t7, rt_edit_snz
    beqz $t8, rt_edit_snz
    li $t7, 42
    j rt_edit_out
rt_edit_snz:
    addiu $t7, $t7, 48
    li $t8, 0
    j rt_edit_out
rt_edit_pt:
    li $t7, 46
    li $t8, 0
    j rt_edit_out
rt_edit_cm:
    li $t7, 44
    beqz $t8, rt_edit_out
    li $t7, 32
    j rt_edit_out
rt_edit_b:
    li $t7, 32
    j rt_edit_out
rt_edit_minus:
    li $t7, 32
    beqz $t9, rt_edit_out
    li $t7, 45
    j rt_edit_out
rt_edit_plus:
    li $t7, 43
    beqz $t9, rt_edit_out
    li $t7, 45
rt_edit_out:
    sb $t7, 0($t1)
    addiu $t1, $t1, 1
    addiu $t0, $t0, 1
    j rt_edit_w
rt_edit_end:
    jr $ra
