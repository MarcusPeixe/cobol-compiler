# Compare $a2 bytes at $a0 and $a1; $a3 selects signed DISPLAY ordering.
rt_index_compare:
    bnez $a3, rt_index_compare_numeric
    move $t0, $zero
rt_index_compare_loop:
    beq $t0, $a2, rt_index_compare_equal
    addu $t1, $a0, $t0
    lbu $t2, 0($t1)
    addu $t1, $a1, $t0
    lbu $t3, 0($t1)
    blt $t2, $t3, rt_index_compare_less
    bgt $t2, $t3, rt_index_compare_greater
    addiu $t0, $t0, 1
    j rt_index_compare_loop
rt_index_compare_less:
    li $v0, -1
    jr $ra
rt_index_compare_greater:
    li $v0, 1
    jr $ra
rt_index_compare_equal:
    move $v0, $zero
    jr $ra

rt_index_compare_numeric:
    addu $t0, $a0, $a2
    lbu $t4, -1($t0)
    sltiu $t4, $t4, 0x70
    xori $t4, $t4, 1
    addu $t0, $a1, $a2
    lbu $t5, -1($t0)
    sltiu $t5, $t5, 0x70
    xori $t5, $t5, 1
    move $t0, $zero
    move $t6, $zero
    move $t7, $zero
    move $t8, $zero
rt_index_compare_numeric_loop:
    beq $t0, $a2, rt_index_compare_numeric_sign
    addu $t1, $a0, $t0
    lbu $t2, 0($t1)
    addu $t1, $a1, $t0
    lbu $t3, 0($t1)
    addiu $t1, $a2, -1
    bne $t0, $t1, rt_index_compare_numeric_digits
    beqz $t4, rt_index_compare_numeric_right
    addiu $t2, $t2, -0x40
rt_index_compare_numeric_right:
    beqz $t5, rt_index_compare_numeric_digits
    addiu $t3, $t3, -0x40
rt_index_compare_numeric_digits:
    addiu $t2, $t2, -48
    addiu $t3, $t3, -48
    or $t7, $t7, $t2
    or $t8, $t8, $t3
    bnez $t6, rt_index_compare_numeric_next
    slt $t1, $t2, $t3
    slt $t9, $t3, $t2
    subu $t6, $t9, $t1
rt_index_compare_numeric_next:
    addiu $t0, $t0, 1
    j rt_index_compare_numeric_loop
rt_index_compare_numeric_sign:
    sltu $t7, $zero, $t7
    sltu $t8, $zero, $t8
    and $t4, $t4, $t7
    and $t5, $t5, $t8
    beq $t4, $t5, rt_index_compare_numeric_same_sign
    subu $v0, $t5, $t4
    jr $ra
rt_index_compare_numeric_same_sign:
    move $v0, $t6
    beqz $t4, rt_index_compare_numeric_done
    negu $v0, $v0
rt_index_compare_numeric_done:
    jr $ra

# Select =, >, >=, <, <=, first, or next (0..6), preserving duplicate order.
# $a0=head, $a1=key (or cursor for next), $a2=offset, $a3=length;
# relation and signed-key flag are on the stack.
rt_index_select:
    lw $t0, 0($sp)
    lw $t1, 4($sp)
    addiu $sp, $sp, -36
    sw $s0, 0($sp)
    sw $s1, 4($sp)
    sw $s2, 8($sp)
    sw $s3, 12($sp)
    sw $s4, 16($sp)
    sw $s5, 20($sp)
    sw $s6, 24($sp)
    sw $s7, 28($sp)
    sw $ra, 32($sp)
    move $s0, $a0
    move $s1, $a1
    move $s2, $a2
    move $s3, $a3
    move $s4, $t0
    move $s7, $t1
    move $s5, $zero
    move $s6, $s0
rt_index_select_loop:
    beqz $s6, rt_index_select_done
    li $t0, 5
    beq $s4, $t0, rt_index_select_candidate
    addiu $a0, $s6, 4
    addu $a0, $a0, $s2
    move $a1, $s1
    li $t0, 6
    bne $s4, $t0, rt_index_select_compare
    addiu $a1, $s1, 4
    addu $a1, $a1, $s2
rt_index_select_compare:
    move $a2, $s3
    move $a3, $s7
    jal rt_index_compare
    li $t0, 6
    beq $s4, $t0, rt_index_select_after_cursor
    beqz $s4, rt_index_select_equal
    li $t0, 1
    beq $s4, $t0, rt_index_select_gt
    li $t0, 2
    beq $s4, $t0, rt_index_select_ge
    li $t0, 3
    beq $s4, $t0, rt_index_select_lt
    blez $v0, rt_index_select_candidate
    j rt_index_select_next
rt_index_select_equal:
    beqz $v0, rt_index_select_candidate
    j rt_index_select_next
rt_index_select_gt:
    bgtz $v0, rt_index_select_candidate
    j rt_index_select_next
rt_index_select_ge:
    bgez $v0, rt_index_select_candidate
    j rt_index_select_next
rt_index_select_lt:
    bltz $v0, rt_index_select_candidate
    j rt_index_select_next
rt_index_select_after_cursor:
    bgtz $v0, rt_index_select_candidate
    bnez $v0, rt_index_select_next
    bgtu $s6, $s1, rt_index_select_candidate
    j rt_index_select_next
rt_index_select_candidate:
    beqz $s5, rt_index_select_take
    addiu $a0, $s6, 4
    addu $a0, $a0, $s2
    addiu $a1, $s5, 4
    addu $a1, $a1, $s2
    move $a2, $s3
    move $a3, $s7
    jal rt_index_compare
    bnez $v0, rt_index_select_compare_direction
    bltu $s6, $s5, rt_index_select_take
    j rt_index_select_next
rt_index_select_compare_direction:
    li $t0, 3
    beq $s4, $t0, rt_index_select_max
    li $t0, 4
    beq $s4, $t0, rt_index_select_max
    bltz $v0, rt_index_select_take
    j rt_index_select_next
rt_index_select_max:
    bgtz $v0, rt_index_select_take
    j rt_index_select_next
rt_index_select_take:
    move $s5, $s6
rt_index_select_next:
    lw $s6, 0($s6)
    j rt_index_select_loop
rt_index_select_done:
    move $v0, $s5
    lw $s0, 0($sp)
    lw $s1, 4($sp)
    lw $s2, 8($sp)
    lw $s3, 12($sp)
    lw $s4, 16($sp)
    lw $s5, 20($sp)
    lw $s6, 24($sp)
    lw $s7, 28($sp)
    lw $ra, 32($sp)
    addiu $sp, $sp, 36
    jr $ra

# $a0=&head, $a1=record, $a2=record size.
rt_index_append:
    move $t0, $a0
    move $t1, $a1
    move $t2, $a2
    addiu $a0, $a2, 7
    li $t3, -4
    and $a0, $a0, $t3
    li $v0, 9
    syscall
    lw $t3, 0($t0)
    sw $t3, 0($v0)
    sw $v0, 0($t0)
    addiu $t3, $v0, 4
    li $t4, 0
rt_index_append_copy:
    beq $t4, $t2, rt_index_append_done
    addu $t5, $t1, $t4
    lbu $t6, 0($t5)
    addu $t5, $t3, $t4
    sb $t6, 0($t5)
    addiu $t4, $t4, 1
    j rt_index_append_copy
rt_index_append_done:
    jr $ra

# $a0=descriptor, $a1=&head, $a2=record size. Returns 0 or -1.
rt_index_load:
    addiu $sp, $sp, -20
    sw $s0, 0($sp)
    sw $s1, 4($sp)
    sw $s2, 8($sp)
    sw $s3, 12($sp)
    sw $ra, 16($sp)
    move $s0, $a0
    move $s1, $a1
    move $s2, $a2
rt_index_load_next:
    addiu $a0, $s2, 7
    li $t0, -4
    and $a0, $a0, $t0
    li $v0, 9
    syscall
    move $s3, $v0
    move $a0, $s0
    addiu $a1, $s3, 4
    move $a2, $s2
    li $v0, 14
    syscall
    beqz $v0, rt_index_load_done
    bne $v0, $s2, rt_index_load_failed
    lw $t0, 0($s1)
    sw $t0, 0($s3)
    sw $s3, 0($s1)
    j rt_index_load_next
rt_index_load_failed:
    li $v0, -1
    j rt_index_load_return
rt_index_load_done:
    move $v0, $zero
rt_index_load_return:
    lw $s0, 0($sp)
    lw $s1, 4($sp)
    lw $s2, 8($sp)
    lw $s3, 12($sp)
    lw $ra, 16($sp)
    addiu $sp, $sp, 20
    jr $ra

# Format a 32-bit scaled value as text in fn_buf.
rt_wide_format:
    move $t0, $a0
    slt $t1, $t0, $zero
    beqz $t1, rt_wide_format_positive
    negu $t0, $t0
rt_wide_format_positive:
    la $t2, fn_buf
    addiu $t2, $t2, 255
    sb $zero, 0($t2)
    move $t3, $zero
    li $t4, 10
rt_wide_format_loop:
    divu $t0, $t4
    mflo $t0
    mfhi $t5
    addiu $t5, $t5, 48
    addiu $t2, $t2, -1
    sb $t5, 0($t2)
    addiu $t3, $t3, 1
    beqz $a1, rt_wide_format_continue
    bne $t3, $a1, rt_wide_format_continue
    addiu $t2, $t2, -1
    li $t5, 46
    sb $t5, 0($t2)
rt_wide_format_continue:
    bnez $t0, rt_wide_format_loop
    ble $t3, $a1, rt_wide_format_loop
    beqz $t1, rt_wide_format_done
    addiu $t2, $t2, -1
    li $t5, 45
    sb $t5, 0($t2)
rt_wide_format_done:
    move $a0, $t2
    la $a1, fn_buf
    addiu $a1, $a1, 255
    subu $a1, $a1, $t2
    jr $ra

# Increment an unsigned integer field, optionally preserving it on overflow.
# $a0=address, $a1=size, $a2=check. Returns 1 on overflow.
rt_wide_increment:
    addu $t0, $a0, $a1
    addiu $t0, $t0, -1
    move $t1, $a1
rt_wide_increment_scan:
    beqz $t1, rt_wide_increment_overflow
    lbu $t2, 0($t0)
    li $t3, 57
    bne $t2, $t3, rt_wide_increment_carry
    addiu $t0, $t0, -1
    addiu $t1, $t1, -1
    j rt_wide_increment_scan
rt_wide_increment_overflow:
    li $v0, 1
    bnez $a2, rt_wide_increment_return
    move $t0, $a0
    addiu $t0, $t0, -1
    j rt_wide_increment_zero
rt_wide_increment_carry:
    addiu $t2, $t2, 1
    sb $t2, 0($t0)
    move $v0, $zero
rt_wide_increment_zero:
    addiu $t0, $t0, 1
    addu $t1, $a0, $a1
rt_wide_increment_zero_loop:
    beq $t0, $t1, rt_wide_increment_return
    li $t2, 48
    sb $t2, 0($t0)
    addiu $t0, $t0, 1
    j rt_wide_increment_zero_loop
rt_wide_increment_return:
    jr $ra

# Read a numeric line and align its DISPLAY digits into the target.
rt_wide_accept:
    addiu $sp, $sp, -36
    sw $s0, 0($sp)
    sw $s1, 4($sp)
    sw $s2, 8($sp)
    sw $s3, 12($sp)
    sw $s4, 16($sp)
    sw $s5, 20($sp)
    sw $s6, 24($sp)
    sw $s7, 28($sp)
    sw $ra, 32($sp)
    move $s0, $a0
    move $s1, $a1
    move $s2, $a2
    move $s3, $a3
    move $s4, $zero
    move $s5, $zero
    move $s6, $zero
    move $s7, $zero
    la $a0, tmp_buf
    li $a1, 255
    li $v0, 8
    syscall
    la $t0, tmp_buf
    la $t1, fn_buf
rt_wide_accept_loop:
    lbu $t2, 0($t0)
    beqz $t2, rt_wide_accept_end
    li $t3, 45
    bne $t2, $t3, rt_wide_accept_point
    li $s4, 1
    j rt_wide_accept_next
rt_wide_accept_point:
    li $t3, 46
    bne $t2, $t3, rt_wide_accept_digit
    li $s6, 1
    j rt_wide_accept_next
rt_wide_accept_digit:
    addiu $t3, $t2, -48
    sltiu $t3, $t3, 10
    beqz $t3, rt_wide_accept_next
    sb $t2, 0($t1)
    addiu $t1, $t1, 1
    addiu $s7, $s7, 1
    beqz $s6, rt_wide_accept_next
    addiu $s5, $s5, 1
rt_wide_accept_next:
    addiu $t0, $t0, 1
    j rt_wide_accept_loop
rt_wide_accept_end:
    bnez $s7, rt_wide_accept_sign
    li $t2, 48
    sb $t2, 0($t1)
    addiu $t1, $t1, 1
    li $s7, 1
rt_wide_accept_sign:
    beqz $s4, rt_wide_accept_move
    lbu $t2, -1($t1)
    addiu $t2, $t2, 0x40
    sb $t2, -1($t1)
rt_wide_accept_move:
    la $a0, fn_buf
    move $a1, $s7
    move $a2, $s0
    move $a3, $s1
    addiu $sp, $sp, -12
    sw $s5, 0($sp)
    sw $s2, 4($sp)
    sw $s3, 8($sp)
    jal rt_wide_move
    addiu $sp, $sp, 12
    lw $s0, 0($sp)
    lw $s1, 4($sp)
    lw $s2, 8($sp)
    lw $s3, 12($sp)
    lw $s4, 16($sp)
    lw $s5, 20($sp)
    lw $s6, 24($sp)
    lw $s7, 28($sp)
    lw $ra, 32($sp)
    addiu $sp, $sp, 36
    jr $ra

# Compare two DISPLAY values, with scales on the stack. Returns -1, 0 or 1.
rt_wide_compare:
    lw $t0, 0($sp)
    lw $t1, 4($sp)
    addiu $sp, $sp, -32
    sw $s0, 0($sp)
    sw $s1, 4($sp)
    sw $s2, 8($sp)
    sw $s3, 12($sp)
    sw $s4, 16($sp)
    sw $s5, 20($sp)
    sw $s6, 24($sp)
    sw $s7, 28($sp)
    move $s0, $a0
    move $s1, $a1
    move $s2, $a2
    move $s3, $a3
    move $s4, $t0
    move $s5, $t1
    addu $t0, $s0, $s1
    lbu $t0, -1($t0)
    sltiu $t0, $t0, 0x70
    xori $s6, $t0, 1
    addu $t0, $s2, $s3
    lbu $t0, -1($t0)
    sltiu $t0, $t0, 0x70
    xori $s7, $t0, 1
    beqz $s6, rt_wide_compare_sign_right
    move $t0, $zero
rt_wide_compare_zero_left:
    beq $t0, $s1, rt_wide_compare_clear_left
    addu $t1, $s0, $t0
    lbu $t1, 0($t1)
    sltiu $t2, $t1, 0x70
    bnez $t2, rt_wide_compare_zero_left_digit
    addiu $t1, $t1, -0x40
rt_wide_compare_zero_left_digit:
    li $t2, 48
    bne $t1, $t2, rt_wide_compare_sign_right
    addiu $t0, $t0, 1
    j rt_wide_compare_zero_left
rt_wide_compare_clear_left:
    move $s6, $zero
rt_wide_compare_sign_right:
    beqz $s7, rt_wide_compare_signs
    move $t0, $zero
rt_wide_compare_zero_right:
    beq $t0, $s3, rt_wide_compare_clear_right
    addu $t1, $s2, $t0
    lbu $t1, 0($t1)
    sltiu $t2, $t1, 0x70
    bnez $t2, rt_wide_compare_zero_right_digit
    addiu $t1, $t1, -0x40
rt_wide_compare_zero_right_digit:
    li $t2, 48
    bne $t1, $t2, rt_wide_compare_signs
    addiu $t0, $t0, 1
    j rt_wide_compare_zero_right
rt_wide_compare_clear_right:
    move $s7, $zero
rt_wide_compare_signs:
    beq $s6, $s7, rt_wide_compare_align
    li $v0, 1
    beqz $s6, rt_wide_compare_return
    li $v0, -1
    j rt_wide_compare_return
rt_wide_compare_align:
    subu $t0, $s1, $s4
    subu $t1, $s3, $s5
    move $t2, $t0
    bge $t0, $t1, rt_wide_compare_int_max
    move $t2, $t1
rt_wide_compare_int_max:
    subu $t0, $t2, $t0
    subu $t1, $t2, $t1
    move $t3, $s4
    bge $s4, $s5, rt_wide_compare_scale_max
    move $t3, $s5
rt_wide_compare_scale_max:
    addu $t3, $t3, $t2
    move $t4, $zero
rt_wide_compare_loop:
    beq $t4, $t3, rt_wide_compare_equal
    subu $t5, $t4, $t0
    li $t6, 48
    bltz $t5, rt_wide_compare_right
    bge $t5, $s1, rt_wide_compare_right
    addu $t5, $s0, $t5
    lbu $t6, 0($t5)
    sltiu $t7, $t6, 0x70
    bnez $t7, rt_wide_compare_right
    addiu $t6, $t6, -0x40
rt_wide_compare_right:
    subu $t5, $t4, $t1
    li $t7, 48
    bltz $t5, rt_wide_compare_digits
    bge $t5, $s3, rt_wide_compare_digits
    addu $t5, $s2, $t5
    lbu $t7, 0($t5)
    sltiu $t8, $t7, 0x70
    bnez $t8, rt_wide_compare_digits
    addiu $t7, $t7, -0x40
rt_wide_compare_digits:
    blt $t6, $t7, rt_wide_compare_less
    bgt $t6, $t7, rt_wide_compare_greater
    addiu $t4, $t4, 1
    j rt_wide_compare_loop
rt_wide_compare_less:
    li $v0, -1
    j rt_wide_compare_invert
rt_wide_compare_greater:
    li $v0, 1
rt_wide_compare_invert:
    beqz $s6, rt_wide_compare_return
    negu $v0, $v0
    j rt_wide_compare_return
rt_wide_compare_equal:
    move $v0, $zero
rt_wide_compare_return:
    lw $s0, 0($sp)
    lw $s1, 4($sp)
    lw $s2, 8($sp)
    lw $s3, 12($sp)
    lw $s4, 16($sp)
    lw $s5, 20($sp)
    lw $s6, 24($sp)
    lw $s7, 28($sp)
    addiu $sp, $sp, 32
    jr $ra

# Move DISPLAY digits with decimal alignment. Scales and destination sign
# flag are passed on the stack; source is copied first to permit overlap.
rt_wide_move:
    lw $t0, 0($sp)
    lw $t1, 4($sp)
    lw $t2, 8($sp)
    subu $t3, $a1, $t0
    subu $t4, $a3, $t1
    subu $t3, $t3, $t4
    addiu $t4, $a1, 3
    li $t5, -4
    and $t4, $t4, $t5
    subu $sp, $sp, $t4
    move $t5, $zero
    move $t6, $zero
rt_wide_copy_source:
    beq $t5, $a1, rt_wide_move_digits
    addu $t7, $a0, $t5
    lbu $t8, 0($t7)
    addiu $t9, $a1, -1
    bne $t5, $t9, rt_wide_copy_source_byte
    sltiu $t9, $t8, 0x70
    bnez $t9, rt_wide_copy_source_byte
    addiu $t8, $t8, -0x40
    li $t6, 1
rt_wide_copy_source_byte:
    addu $t7, $sp, $t5
    sb $t8, 0($t7)
    addiu $t5, $t5, 1
    j rt_wide_copy_source
rt_wide_move_digits:
    move $t5, $zero
rt_wide_move_loop:
    beq $t5, $a3, rt_wide_move_done
    addu $t7, $t5, $t3
    li $t8, 48
    bltz $t7, rt_wide_move_store
    bge $t7, $a1, rt_wide_move_store
    addu $t7, $sp, $t7
    lbu $t8, 0($t7)
rt_wide_move_store:
    beqz $t2, rt_wide_move_unsigned
    beqz $t6, rt_wide_move_unsigned
    addiu $t7, $a3, -1
    bne $t5, $t7, rt_wide_move_unsigned
    addiu $t8, $t8, 0x40
rt_wide_move_unsigned:
    addu $t7, $a2, $t5
    sb $t8, 0($t7)
    addiu $t5, $t5, 1
    j rt_wide_move_loop
rt_wide_move_done:
    addu $sp, $sp, $t4
    jr $ra

# ---- runtime -------------------------------------------------------------
# rt_print: $a0 = address, $a1 = length. Prints the bytes.
rt_print:
    move $t0, $a0
    addu $t1, $a0, $a1
rt_print_l:
    beq $t0, $t1, rt_print_d
    lbu $a0, 0($t0)
    li $v0, 11
    syscall
    addiu $t0, $t0, 1
    j rt_print_l
rt_print_d:
    jr $ra

# rt_print_num: $a0 = address, $a1 = size, $a2 = scale, $a3 = signed.
# Prints a DISPLAY numeric field: optional sign, digits, decimal point.
rt_print_num:
    move $t0, $a0
    addu $t1, $a0, $a1
    beqz $a3, rt_print_num_digits
    lbu $t2, -1($t1)
    li $a0, 43
    sltiu $t3, $t2, 0x70
    bnez $t3, rt_print_num_sign
    li $a0, 45
rt_print_num_sign:
    li $v0, 11
    syscall
rt_print_num_digits:
    subu $t4, $a1, $a2
    li $t5, 0
rt_print_num_l:
    beq $t5, $a1, rt_print_num_d
    beqz $a2, rt_print_num_nopt
    bne $t5, $t4, rt_print_num_nopt
    li $a0, 46
    li $v0, 11
    syscall
rt_print_num_nopt:
    addu $t6, $t0, $t5
    lbu $a0, 0($t6)
    sltiu $t7, $a0, 0x70
    bnez $t7, rt_print_num_ch
    addiu $a0, $a0, -0x40
rt_print_num_ch:
    li $v0, 11
    syscall
    addiu $t5, $t5, 1
    j rt_print_num_l
rt_print_num_d:
    jr $ra

# rt_print_val: $a0 = scaled integer value, $a1 = scale. Prints it with a decimal point.
rt_print_val:
    move $t0, $a0
    bgez $t0, rt_print_val_abs
    li $a0, 45
    li $v0, 11
    syscall
    negu $t0, $t0
rt_print_val_abs:
    li $t1, 1
    li $t2, 0
    li $t3, 10
rt_print_val_p:
    beq $t2, $a1, rt_print_val_i
    mul $t1, $t1, $t3
    addiu $t2, $t2, 1
    j rt_print_val_p
rt_print_val_i:
    div $t0, $t1
    mflo $a0
    mfhi $t0
    li $v0, 1
    syscall
    beqz $a1, rt_print_val_d
    li $a0, 46
    li $v0, 11
    syscall
rt_print_val_f:
    beqz $a1, rt_print_val_d
    div $t1, $t3
    mflo $t1
    div $t0, $t1
    mflo $a0
    mfhi $t0
    addiu $a0, $a0, 48
    li $v0, 11
    syscall
    addiu $a1, $a1, -1
    j rt_print_val_f
rt_print_val_d:
    jr $ra

# rt_num_load: $a0 = address, $a1 = size. Returns the signed integer in $v0.
rt_num_load:
    li $v0, 0
    li $t2, 0
    li $t4, 10
    addu $t1, $a0, $a1
rt_num_load_l:
    beq $a0, $t1, rt_num_load_d
    lbu $t0, 0($a0)
    sltiu $t3, $t0, 0x70
    bnez $t3, rt_num_load_c
    addiu $t0, $t0, -0x40
    li $t2, 1
rt_num_load_c:
    addiu $t0, $t0, -48
    sltiu $t3, $t0, 10
    bnez $t3, rt_num_load_ok
    li $t0, 0
rt_num_load_ok:
    mul $v0, $v0, $t4
    addu $v0, $v0, $t0
    addiu $a0, $a0, 1
    j rt_num_load_l
rt_num_load_d:
    beqz $t2, rt_num_load_r
    negu $v0, $v0
rt_num_load_r:
    jr $ra

# rt_num_store: $a0 = address, $a1 = size, $a2 = signed, $a3 = value.
# Stores the low-order digits of |value|; a negative value in a signed field
# gets an overpunched last digit ('p'-'y').
rt_num_store:
    slt $t2, $a3, $zero
    bgez $a3, rt_num_store_abs
    negu $a3, $a3
rt_num_store_abs:
    addu $t0, $a0, $a1
    li $t4, 10
rt_num_store_l:
    beq $t0, $a0, rt_num_store_sign
    addiu $t0, $t0, -1
    div $a3, $t4
    mflo $a3
    mfhi $t3
    addiu $t3, $t3, 48
    sb $t3, 0($t0)
    j rt_num_store_l
rt_num_store_sign:
    beqz $a2, rt_num_store_d
    beqz $t2, rt_num_store_d
    addu $t0, $a0, $a1
    lbu $t3, -1($t0)
    addiu $t3, $t3, 0x40
    sb $t3, -1($t0)
rt_num_store_d:
    jr $ra

# rt_fits: $a1 = size, $a3 = value. $v0 = 1 when |value| < 10^size.
rt_fits:
    li $v0, 1
    slti $t0, $a1, 10
    beqz $t0, rt_fits_d
    move $t0, $a3
    bgez $t0, rt_fits_p
    negu $t0, $t0
rt_fits_p:
    li $t1, 1
    li $t2, 0
    li $t4, 10
rt_fits_l:
    beq $t2, $a1, rt_fits_c
    mul $t1, $t1, $t4
    addiu $t2, $t2, 1
    j rt_fits_l
rt_fits_c:
    slt $v0, $t0, $t1
rt_fits_d:
    jr $ra

# rt_copy_pad: $a0 = source, $a1 = source length, $a2 = destination, $a3 = destination length.
# Copies, truncating on the right or padding with spaces.
rt_copy_pad:
    li $t4, 32
rt_copy_pad_l:
    beqz $a3, rt_copy_pad_d
    beqz $a1, rt_copy_pad_p
    lbu $t0, 0($a0)
    sb $t0, 0($a2)
    addiu $a0, $a0, 1
    addiu $a1, $a1, -1
    addiu $a2, $a2, 1
    addiu $a3, $a3, -1
    j rt_copy_pad_l
rt_copy_pad_p:
    beqz $a3, rt_copy_pad_d
    sb $t4, 0($a2)
    addiu $a2, $a2, 1
    addiu $a3, $a3, -1
    j rt_copy_pad_p
rt_copy_pad_d:
    jr $ra

# rt_fill: $a0 = destination, $a1 = length, $a2 = byte.
rt_fill:
    beqz $a1, rt_fill_d
    sb $a2, 0($a0)
    addiu $a0, $a0, 1
    addiu $a1, $a1, -1
    j rt_fill
rt_fill_d:
    jr $ra

# rt_cmp: ($a0, $a1) and ($a2, $a3) are (address, length) pairs.
# Returns -1, 0 or 1 in $v0, padding the shorter operand with spaces.
rt_cmp:
    li $t4, 32
rt_cmp_l:
    or $t0, $a1, $a3
    beqz $t0, rt_cmp_eq
    move $t1, $t4
    beqz $a1, rt_cmp_a
    lbu $t1, 0($a0)
    addiu $a0, $a0, 1
    addiu $a1, $a1, -1
rt_cmp_a:
    move $t2, $t4
    beqz $a3, rt_cmp_b
    lbu $t2, 0($a2)
    addiu $a2, $a2, 1
    addiu $a3, $a3, -1
rt_cmp_b:
    beq $t1, $t2, rt_cmp_l
    sltu $t3, $t1, $t2
    li $v0, -1
    bnez $t3, rt_cmp_r
    li $v0, 1
rt_cmp_r:
    jr $ra
rt_cmp_eq:
    li $v0, 0
    jr $ra

# rt_accept_str: $a0 = destination, $a1 = destination length. Reads a line.
rt_accept_str:
    addiu $sp, $sp, -12
    sw $ra, 0($sp)
    sw $a0, 4($sp)
    sw $a1, 8($sp)
    la $a0, tmp_buf
    li $a1, 255
    li $v0, 8
    syscall
    la $t0, tmp_buf
rt_accept_str_l:
    lbu $t1, 0($t0)
    beqz $t1, rt_accept_str_e
    li $t2, 10
    beq $t1, $t2, rt_accept_str_e
    addiu $t0, $t0, 1
    j rt_accept_str_l
rt_accept_str_e:
    la $a0, tmp_buf
    subu $a1, $t0, $a0
    lw $a2, 4($sp)
    lw $a3, 8($sp)
    jal rt_copy_pad
    lw $ra, 0($sp)
    addiu $sp, $sp, 12
    jr $ra

# rt_accept_num: $a0 = target scale. Reads a line holding a number such as
# -12.5 and returns it scaled to the target scale in $v0 (extra decimals are truncated).
rt_accept_num:
    move $t9, $a0
    la $a0, tmp_buf
    li $a1, 255
    li $v0, 8
    syscall
    la $t0, tmp_buf
    li $v0, 0
    li $t2, 0
    li $t3, 0
    li $t4, 0
    li $t5, 10
rt_accept_num_l:
    lbu $t1, 0($t0)
    beqz $t1, rt_accept_num_adj
    li $t6, 45
    bne $t1, $t6, rt_accept_num_nm
    li $t2, 1
    j rt_accept_num_n
rt_accept_num_nm:
    li $t6, 46
    bne $t1, $t6, rt_accept_num_dg
    li $t4, 1
    j rt_accept_num_n
rt_accept_num_dg:
    addiu $t1, $t1, -48
    sltiu $t6, $t1, 10
    beqz $t6, rt_accept_num_n
    beqz $t4, rt_accept_num_acc
    bge $t3, $t9, rt_accept_num_n
    addiu $t3, $t3, 1
rt_accept_num_acc:
    mul $v0, $v0, $t5
    addu $v0, $v0, $t1
rt_accept_num_n:
    addiu $t0, $t0, 1
    j rt_accept_num_l
rt_accept_num_adj:
    bge $t3, $t9, rt_accept_num_sg
    mul $v0, $v0, $t5
    addiu $t3, $t3, 1
    j rt_accept_num_adj
rt_accept_num_sg:
    beqz $t2, rt_accept_num_r
    negu $v0, $v0
rt_accept_num_r:
    jr $ra

# rt_pow: $a0 = scaled base, $a1 = integer exponent, $a2 = 10^scale.
# Returns base^exponent with the base's scale.
rt_pow:
    move $v0, $a2
rt_pow_l:
    blez $a1, rt_pow_d
    mul $v0, $v0, $a0
    div $v0, $a2
    mflo $v0
    addiu $a1, $a1, -1
    j rt_pow_l
rt_pow_d:
    jr $ra

# rt_case: $a0 = address, $a1 = length, $a2 = 1 for upper case, 0 for lower case. In place.
rt_case:
    addu $t0, $a0, $a1
rt_case_l:
    beq $a0, $t0, rt_case_d
    lbu $t1, 0($a0)
    beqz $a2, rt_case_lo
    li $t2, 97
    li $t3, 122
    blt $t1, $t2, rt_case_n
    bgt $t1, $t3, rt_case_n
    addiu $t1, $t1, -32
    sb $t1, 0($a0)
    j rt_case_n
rt_case_lo:
    li $t2, 65
    li $t3, 90
    blt $t1, $t2, rt_case_n
    bgt $t1, $t3, rt_case_n
    addiu $t1, $t1, 32
    sb $t1, 0($a0)
rt_case_n:
    addiu $a0, $a0, 1
    j rt_case_l
rt_case_d:
    jr $ra

# rt_edit: $a0 = destination, $a1 = picture (NUL-terminated), $a2 = scaled value.
# Numeric editing with 9 Z * . , B 0 / $ and a single leading or trailing + or -.
rt_edit:
    slt $t9, $a2, $zero
    bgez $a2, rt_edit_abs
    negu $a2, $a2
rt_edit_abs:
    move $t0, $a1
    li $t1, 0
rt_edit_count:
    lbu $t2, 0($t0)
    beqz $t2, rt_edit_digits
    li $t3, 57
    beq $t2, $t3, rt_edit_cn
    li $t3, 90
    beq $t2, $t3, rt_edit_cn
    li $t3, 42
    beq $t2, $t3, rt_edit_cn
    j rt_edit_cs
rt_edit_cn:
    addiu $t1, $t1, 1
rt_edit_cs:
    addiu $t0, $t0, 1
    j rt_edit_count
rt_edit_digits:
    la $t4, ed_digits
    addu $t5, $t4, $t1
    li $t6, 10
rt_edit_dl:
    beq $t5, $t4, rt_edit_walk
    addiu $t5, $t5, -1
    div $a2, $t6
    mflo $a2
    mfhi $t7
    sb $t7, 0($t5)
    j rt_edit_dl
rt_edit_walk:
    move $t0, $a1
    move $t1, $a0
    li $t8, 1
rt_edit_w:
    lbu $t2, 0($t0)
    beqz $t2, rt_edit_end
    li $t3, 57
    beq $t2, $t3, rt_edit_9
    li $t3, 90
    beq $t2, $t3, rt_edit_z
    li $t3, 42
    beq $t2, $t3, rt_edit_star
    li $t3, 46
    beq $t2, $t3, rt_edit_pt
    li $t3, 44
    beq $t2, $t3, rt_edit_cm
    li $t3, 66
    beq $t2, $t3, rt_edit_b
    li $t3, 45
    beq $t2, $t3, rt_edit_minus
    li $t3, 43
    beq $t2, $t3, rt_edit_plus
    move $t7, $t2
    j rt_edit_out
rt_edit_9:
    lbu $t7, 0($t4)
    addiu $t4, $t4, 1
    addiu $t7, $t7, 48
    li $t8, 0
    j rt_edit_out
rt_edit_z:
    lbu $t7, 0($t4)
    addiu $t4, $t4, 1
    bnez $t7, rt_edit_znz
    beqz $t8, rt_edit_znz
    li $t7, 32
    j rt_edit_out
rt_edit_znz:
    addiu $t7, $t7, 48
    li $t8, 0
    j rt_edit_out
rt_edit_star:
    lbu $t7, 0($t4)
    addiu $t4, $t4, 1
    bnez $t7, rt_edit_snz
    beqz $t8, rt_edit_snz
    li $t7, 42
    j rt_edit_out
rt_edit_snz:
    addiu $t7, $t7, 48
    li $t8, 0
    j rt_edit_out
rt_edit_pt:
    li $t7, 46
    li $t8, 0
    j rt_edit_out
rt_edit_cm:
    li $t7, 44
    beqz $t8, rt_edit_out
    li $t7, 32
    j rt_edit_out
rt_edit_b:
    li $t7, 32
    j rt_edit_out
rt_edit_minus:
    li $t7, 32
    beqz $t9, rt_edit_out
    li $t7, 45
    j rt_edit_out
rt_edit_plus:
    li $t7, 43
    beqz $t9, rt_edit_out
    li $t7, 45
rt_edit_out:
    sb $t7, 0($t1)
    addiu $t1, $t1, 1
    addiu $t0, $t0, 1
    j rt_edit_w
rt_edit_end:
    jr $ra
