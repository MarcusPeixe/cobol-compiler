       IDENTIFICATION DIVISION.
       PROGRAM-ID. IOTEST.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT IN-FILE ASSIGN TO "IN.DAT"
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS IS WS-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD IN-FILE
           RECORD CONTAINS 10 CHARACTERS.
       01 IN-RECORD PIC X(10).
       WORKING-STORAGE SECTION.
       77 WS-STATUS PIC 99.
       77 WS-LINE PIC X(10).
       77 WS-POS PIC 9.
       PROCEDURE DIVISION.
       MAIN-PARA.
           OPEN INPUT IN-FILE.
           SET WS-POS UP BY 1.
           READ IN-FILE INTO WS-LINE
               AT END DISPLAY "EOF"
               NOT AT END DISPLAY WS-LINE
           END-READ.
           START IN-FILE KEY NOT LESS THAN WS-LINE
               INVALID KEY DISPLAY "NONE"
           END-START.
           CLOSE IN-FILE.
           STOP RUN.
