       IDENTIFICATION DIVISION.
       PROGRAM-ID. NUMERIC-TEST.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 VALUE-A PIC S9(3)V99 VALUE 0.
       01 RESULT-A PIC S9(5)V99.
       01 EDITED-A PIC -ZZZZ9.99.
       01 SMALL-A PIC 99 VALUE 99.
       01 REMAINDER-A PIC 9.
       PROCEDURE DIVISION.
       MAIN-PROCEDURE.
           MOVE -1.25 TO VALUE-A.
           MOVE VALUE-A TO RESULT-A.
           DISPLAY "SIGNED=" RESULT-A.
           MOVE RESULT-A TO EDITED-A.
           DISPLAY "EDITED=" EDITED-A.
           COMPUTE RESULT-A = 0.1 + 0.2.
           MOVE RESULT-A TO EDITED-A.
           DISPLAY "SUM=" EDITED-A.
           COMPUTE RESULT-A = 1 / 3 * 3.
           MOVE RESULT-A TO EDITED-A.
           DISPLAY "RATIONAL=" EDITED-A.
           COMPUTE RESULT-A = 2 ** 0.5.
           MOVE RESULT-A TO EDITED-A.
           DISPLAY "ROOT=" EDITED-A.
           COMPUTE RESULT-A = 2 ** -1.
           MOVE RESULT-A TO EDITED-A.
           DISPLAY "NEGATIVE-POWER=" EDITED-A.
           ADD 1 TO SMALL-A
             ON SIZE ERROR DISPLAY "SIZE=" SMALL-A.
           MOVE 42 TO SMALL-A.
           DIVIDE 7 BY 0 GIVING SMALL-A
             ON SIZE ERROR DISPLAY "DIVZERO=" SMALL-A.
           DIVIDE 7 BY 2 GIVING SMALL-A REMAINDER REMAINDER-A.
           DISPLAY "QUOTIENT=" SMALL-A " REMAINDER=" REMAINDER-A.
           STOP RUN.
       END PROGRAM NUMERIC-TEST.
