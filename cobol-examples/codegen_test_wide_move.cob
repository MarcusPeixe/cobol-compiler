       IDENTIFICATION DIVISION.
       PROGRAM-ID. CODEGEN-WIDE-MOVE.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       77 WS-LARGE PIC 9(10).
       77 WS-DECIMAL PIC 9(8)V99.
       77 WS-SIGNED PIC S9(10).
       77 WS-SIGNED-COPY PIC S9(12).
       77 WS-EDITED PIC -ZZZZZZZZZ9.99.
       PROCEDURE DIVISION.
       MAIN-PARA.
           MOVE 1234567890 TO WS-LARGE.
           DISPLAY "LARGE=" WS-LARGE.
           MOVE WS-LARGE TO WS-DECIMAL.
           DISPLAY "DECIMAL=" WS-DECIMAL.
           MOVE WS-DECIMAL TO WS-LARGE.
           DISPLAY "TRUNCATED=" WS-LARGE.
           MOVE -1234567890 TO WS-SIGNED.
           MOVE WS-SIGNED TO WS-SIGNED-COPY.
           DISPLAY "SIGNED=" WS-SIGNED-COPY.
           MOVE WS-SIGNED-COPY TO WS-EDITED.
           DISPLAY "EDITED-NEGATIVE=" WS-EDITED.
           MOVE 9876543210 TO WS-EDITED.
           DISPLAY "EDITED-LARGE=" WS-EDITED.
           MOVE WS-SIGNED-COPY TO WS-LARGE.
           DISPLAY "UNSIGNED=" WS-LARGE.
           IF WS-LARGE = 1234567890
               DISPLAY "LARGE-EQUAL"
           END-IF.
           IF WS-SIGNED < -1234567889
               DISPLAY "NEGATIVE-LESS"
           END-IF.
           IF WS-DECIMAL = 34567890
               DISPLAY "DECIMAL-EQUAL"
           END-IF.
           MOVE -0 TO WS-SIGNED.
           IF WS-SIGNED = ZERO
               DISPLAY "ZERO-EQUAL"
           END-IF.
           MOVE 2147483647 TO WS-LARGE.
           ADD 1 TO WS-LARGE.
           DISPLAY "INCREMENT=" WS-LARGE.
           MOVE 9999999999 TO WS-LARGE.
           ADD 1 TO WS-LARGE
               ON SIZE ERROR DISPLAY "OVERFLOW".
           DISPLAY "PRESERVED=" WS-LARGE.
           ACCEPT WS-LARGE.
           ACCEPT WS-DECIMAL.
           ACCEPT WS-SIGNED.
           DISPLAY "INPUT=" WS-LARGE "," WS-DECIMAL "," WS-SIGNED.
           STOP RUN.
