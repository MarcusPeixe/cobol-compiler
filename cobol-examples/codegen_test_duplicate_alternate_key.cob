       IDENTIFICATION DIVISION.
       PROGRAM-ID. DUPLICATE-ALTERNATE-KEY.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DATA-FILE ASSIGN TO "INDEX.DAT"
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS RECORD-ID
               ALTERNATE RECORD KEY IS RECORD-NAME
                   WITH DUPLICATES
               FILE STATUS IS WS-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD DATA-FILE.
       01 DATA-RECORD.
           05 RECORD-ID PIC 99.
           05 RECORD-NAME PIC X(3).
       WORKING-STORAGE SECTION.
       77 WS-STATUS PIC 99.
       77 WS-RECORD PIC X(5).
       PROCEDURE DIVISION.
       MAIN-PARA.
           OPEN OUTPUT DATA-FILE.
           MOVE "03ABC" TO WS-RECORD.
           WRITE DATA-RECORD FROM WS-RECORD.
           DISPLAY "FIRST-WRITE=" WS-STATUS.
           MOVE "01ABC" TO WS-RECORD.
           WRITE DATA-RECORD FROM WS-RECORD.
           DISPLAY "DUP-WRITE=" WS-STATUS.
           MOVE "02DEF" TO WS-RECORD.
           WRITE DATA-RECORD FROM WS-RECORD.
           MOVE "04ABC" TO WS-RECORD.
           WRITE DATA-RECORD FROM WS-RECORD.
           DISPLAY "THIRD-WRITE=" WS-STATUS.
           MOVE "03XYZ" TO WS-RECORD.
           WRITE DATA-RECORD FROM WS-RECORD
               INVALID KEY DISPLAY "DUP-PRIMARY=" WS-STATUS
           END-WRITE.
           CLOSE DATA-FILE.
           OPEN INPUT DATA-FILE.
           MOVE "ABC" TO RECORD-NAME.
           READ DATA-FILE RECORD KEY RECORD-NAME
               NOT INVALID KEY DISPLAY "KEY=" DATA-RECORD ":" WS-STATUS
           END-READ.
           READ DATA-FILE
               NOT AT END DISPLAY "NEXT=" DATA-RECORD ":" WS-STATUS
           END-READ.
           READ DATA-FILE
               NOT AT END DISPLAY "NEXT=" DATA-RECORD ":" WS-STATUS
           END-READ.
           READ DATA-FILE
               NOT AT END DISPLAY "NEXT=" DATA-RECORD ":" WS-STATUS
           END-READ.
           READ DATA-FILE AT END DISPLAY "END=" WS-STATUS END-READ.
           MOVE "ABC" TO RECORD-NAME.
           START DATA-FILE KEY LESS THAN OR EQUAL TO RECORD-NAME
               INVALID KEY DISPLAY "UNEXPECTED START"
           END-START.
           READ DATA-FILE
               NOT AT END DISPLAY "START=" DATA-RECORD ":" WS-STATUS
           END-READ.
           CLOSE DATA-FILE.
           OPEN I-O DATA-FILE.
           MOVE "05ABC" TO WS-RECORD.
           WRITE DATA-RECORD FROM WS-RECORD.
           DISPLAY "REOPEN-WRITE=" WS-STATUS.
           CLOSE DATA-FILE.
           STOP RUN.
