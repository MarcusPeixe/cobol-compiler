       IDENTIFICATION DIVISION.
       PROGRAM-ID. CODEGEN-INDEXED-FILE.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DATA-FILE ASSIGN TO "INDEX.DAT"
               ORGANIZATION INDEXED
               ACCESS MODE DYNAMIC
               RECORD KEY IS RECORD-ID
               ALTERNATE RECORD KEY IS RECORD-NAME
               FILE STATUS WS-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD DATA-FILE.
       01 DATA-RECORD.
          05 RECORD-ID PIC 99.
          05 RECORD-NAME PIC X(3).
       WORKING-STORAGE SECTION.
       77 WS-STATUS PIC 99.
       77 WS-RECORD PIC X(5).
       PROCEDURE DIVISION.
       MAIN-PARA.
           OPEN OUTPUT DATA-FILE.
           MOVE "01ABC" TO WS-RECORD.
           WRITE DATA-RECORD FROM WS-RECORD
               INVALID KEY DISPLAY "UNEXPECTED DUPLICATE"
           END-WRITE.
           MOVE "02DEF" TO WS-RECORD.
           WRITE DATA-RECORD FROM WS-RECORD.
           MOVE "01XYZ" TO WS-RECORD.
           WRITE DATA-RECORD FROM WS-RECORD
               INVALID KEY DISPLAY "DUP-ID=" WS-STATUS
           END-WRITE.
           MOVE "03ABC" TO WS-RECORD.
           WRITE DATA-RECORD FROM WS-RECORD
               INVALID KEY DISPLAY "DUP-NAME=" WS-STATUS
           END-WRITE.
           CLOSE DATA-FILE.
           OPEN I-O DATA-FILE.
           MOVE 2 TO RECORD-ID.
           READ DATA-FILE RECORD KEY RECORD-ID
               INVALID KEY DISPLAY "UNEXPECTED MISSING"
               NOT INVALID KEY DISPLAY "FOUND=" DATA-RECORD
           END-READ.
           START DATA-FILE KEY EQUAL RECORD-ID
               INVALID KEY DISPLAY "UNEXPECTED START"
               NOT INVALID KEY DISPLAY "START=" WS-STATUS
           END-START.
           MOVE "03GHI" TO WS-RECORD.
           WRITE DATA-RECORD FROM WS-RECORD.
           CLOSE DATA-FILE.
           OPEN INPUT DATA-FILE.
           MOVE 1 TO RECORD-ID.
           START DATA-FILE KEY GREATER THAN RECORD-ID
               INVALID KEY DISPLAY "UNEXPECTED START"
           END-START.
           READ DATA-FILE
               NOT AT END DISPLAY "NEXT=" DATA-RECORD
           END-READ.
           READ DATA-FILE
               NOT AT END DISPLAY "NEXT=" DATA-RECORD
           END-READ.
           READ DATA-FILE
               AT END DISPLAY "END=" WS-STATUS
           END-READ.
           MOVE 3 TO RECORD-ID.
           START DATA-FILE KEY LESS THAN RECORD-ID
               INVALID KEY DISPLAY "UNEXPECTED START"
           END-START.
           READ DATA-FILE
               NOT AT END DISPLAY "LESS=" DATA-RECORD
           END-READ.
           MOVE 9 TO RECORD-ID.
           READ DATA-FILE RECORD KEY RECORD-ID
               INVALID KEY DISPLAY "MISSING=" WS-STATUS
           END-READ.
           MOVE "ABC" TO RECORD-NAME.
           READ DATA-FILE RECORD KEY RECORD-NAME
               NOT INVALID KEY DISPLAY "ALTERNATE=" DATA-RECORD
           END-READ.
           CLOSE DATA-FILE.
           STOP RUN.
