       IDENTIFICATION DIVISION.
       PROGRAM-ID. INDEXED-SEQUENTIAL-TEST.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT TEST-FILE ASSIGN TO "indexed.dat"
              ORGANIZATION INDEXED
              ACCESS MODE DYNAMIC
              RECORD KEY TEST-KEY.
       DATA DIVISION.
       FILE SECTION.
       FD TEST-FILE.
       01 TEST-RECORD.
          05 TEST-KEY PIC 99.
       PROCEDURE DIVISION.
       MAIN-PROCEDURE.
           READ TEST-FILE NEXT RECORD.
           STOP RUN.
       END PROGRAM INDEXED-SEQUENTIAL-TEST.
