       IDENTIFICATION DIVISION.
       PROGRAM-ID. WRITE-ADVANCING.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT OUT-FILE ASSIGN TO "ADVANCE.DAT"
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS IS WS-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD OUT-FILE.
       01 OUT-RECORD PIC X(4).
       WORKING-STORAGE SECTION.
       77 WS-STATUS PIC 99.
       77 WS-LINES PIC S9 VALUE 1.
       PROCEDURE DIVISION.
       MAIN-PARA.
           OPEN OUTPUT OUT-FILE.
           MOVE "ONE1" TO OUT-RECORD.
           WRITE OUT-RECORD AFTER ADVANCING 2 LINES.
           MOVE "TWO2" TO OUT-RECORD.
           WRITE OUT-RECORD BEFORE ADVANCING PAGE.
           MOVE "END3" TO OUT-RECORD.
           WRITE OUT-RECORD AFTER ADVANCING WS-LINES LINES.
           MOVE "ZERO" TO OUT-RECORD.
           WRITE OUT-RECORD BEFORE ADVANCING 0 LINES.
           DISPLAY "STATUS=" WS-STATUS.
           MOVE -1 TO WS-LINES.
           WRITE OUT-RECORD AFTER ADVANCING WS-LINES LINES.
           DISPLAY "INVALID=" WS-STATUS.
           WRITE OUT-RECORD BEFORE ADVANCING WS-LINES LINES.
           DISPLAY "INVALID-BEFORE=" WS-STATUS.
           CLOSE OUT-FILE.
           STOP RUN.
