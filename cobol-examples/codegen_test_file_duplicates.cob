       IDENTIFICATION DIVISION.
       PROGRAM-ID. DUPLICATE-KEY-TEST.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT TEST-FILE ASSIGN TO "duplicates.dat"
              ORGANIZATION INDEXED
              ACCESS MODE DYNAMIC
              RECORD KEY TEST-KEY
              ALTERNATE RECORD KEY TEST-NAME WITH DUPLICATES.
       DATA DIVISION.
       FILE SECTION.
       FD TEST-FILE.
       01 TEST-RECORD.
          05 TEST-KEY PIC 99.
          05 TEST-NAME PIC XX.
       PROCEDURE DIVISION.
       MAIN-PROCEDURE.
           STOP RUN.
       END PROGRAM DUPLICATE-KEY-TEST.
