       IDENTIFICATION DIVISION.
       PROGRAM-ID. CODEGEN-FILE-READ.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DATA-FILE ASSIGN TO "READ.TXT"
               FILE STATUS WS-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD DATA-FILE.
       01 DATA-RECORD PIC X(3).
       WORKING-STORAGE SECTION.
       77 WS-STATUS PIC 99.
       77 WS-RESULT PIC X(3).
       PROCEDURE DIVISION.
       MAIN-PARA.
           OPEN OUTPUT DATA-FILE.
           WRITE DATA-RECORD FROM "ABC".
           CLOSE DATA-FILE.
           OPEN INPUT DATA-FILE.
           WRITE DATA-RECORD FROM "XYZ".
           DISPLAY "BAD-WRITE=" WS-STATUS.
           READ DATA-FILE INTO WS-RESULT
               AT END DISPLAY "UNEXPECTED END"
               NOT AT END DISPLAY "READ=" WS-RESULT
           END-READ.
           DISPLAY "STATUS=" WS-STATUS.
           READ DATA-FILE
               AT END DISPLAY "END=" WS-STATUS
               NOT AT END DISPLAY "UNEXPECTED READ"
           END-READ.
           CLOSE DATA-FILE.
           STOP RUN.
