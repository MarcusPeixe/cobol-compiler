       IDENTIFICATION DIVISION.
       PROGRAM-ID. CODEGEN-FILE-STATUS.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT OUTPUT-FILE ASSIGN TO "STATUS.TXT"
               FILE STATUS WS-STATUS.
           SELECT MISSING-FILE ASSIGN TO "MISSING/STATUS.TXT"
               FILE STATUS WS-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD OUTPUT-FILE.
       01 OUTPUT-RECORD PIC X(3).
       FD MISSING-FILE.
       01 MISSING-RECORD PIC X(3).
       WORKING-STORAGE SECTION.
       77 WS-STATUS PIC XX.
       PROCEDURE DIVISION.
       MAIN-PARA.
           OPEN OUTPUT OUTPUT-FILE.
           DISPLAY "OPEN=" WS-STATUS.
           OPEN OUTPUT OUTPUT-FILE.
           DISPLAY "OPEN-AGAIN=" WS-STATUS.
           WRITE OUTPUT-RECORD FROM "ABC".
           DISPLAY "WRITE=" WS-STATUS.
           CLOSE OUTPUT-FILE.
           DISPLAY "CLOSE=" WS-STATUS.
           CLOSE OUTPUT-FILE.
           DISPLAY "CLOSE-AGAIN=" WS-STATUS.
           OPEN INPUT MISSING-FILE.
           DISPLAY "MISSING=" WS-STATUS.
           STOP RUN.
