       IDENTIFICATION DIVISION.
       PROGRAM-ID. FILE-STATUS-TEST.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT TEST-FILE ASSIGN TO "status.dat"
              ORGANIZATION INDEXED
              ACCESS MODE DYNAMIC
              RECORD KEY IS TEST-KEY
              ALTERNATE RECORD KEY IS TEST-NAME
              FILE STATUS TEST-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD TEST-FILE.
       01 TEST-RECORD.
          05 TEST-KEY PIC S99.
          05 TEST-NAME PIC XX.
       WORKING-STORAGE SECTION.
       01 TEST-STATUS PIC 99.
       PROCEDURE DIVISION.
       MAIN-PROCEDURE.
           OPEN I-O TEST-FILE.
           DISPLAY "MISSING=" TEST-STATUS.
           OPEN OUTPUT TEST-FILE.
           MOVE 1 TO TEST-KEY.
           MOVE "AA" TO TEST-NAME.
           WRITE TEST-RECORD.
           DISPLAY "WRITE=" TEST-STATUS.
           READ TEST-FILE RECORD KEY TEST-KEY.
           DISPLAY "READ-OUTPUT=" TEST-STATUS.
           CLOSE TEST-FILE.
           OPEN I-O TEST-FILE.
           MOVE 2 TO TEST-KEY.
           MOVE "AA" TO TEST-NAME.
           WRITE TEST-RECORD
             INVALID KEY DISPLAY "DUPLICATE=" TEST-STATUS
           END-WRITE.
           MOVE -2 TO TEST-KEY.
           MOVE "BB" TO TEST-NAME.
           WRITE TEST-RECORD.
           MOVE -2 TO TEST-KEY.
           READ TEST-FILE RECORD KEY TEST-KEY
             NOT INVALID KEY DISPLAY "SIGNED=" TEST-KEY
           END-READ.
           MOVE 9 TO TEST-KEY.
           READ TEST-FILE RECORD KEY TEST-KEY
             INVALID KEY DISPLAY "NOT-FOUND=" TEST-STATUS
           END-READ.
           CLOSE TEST-FILE.
           STOP RUN.
       END PROGRAM FILE-STATUS-TEST.
